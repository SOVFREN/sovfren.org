# Base URL of the SovfHub API this site reads from.
# All Register / Property / Companion data lives on SovfHub, not in this repo.
SOVFHUB_API_URL=https://sovfhub.com/api.php
SOVFHUB_API_KEY=

# SovfHub SSO (OAuth2 + PKCE) — Companion Portal login.
# Client registered in SovfHub's sso_clients table as "Sovfren.org".
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=https://sso.sovfhub.com/sso.php
SSO_TOKEN_URL=https://sso.sovfhub.com/sso.token.php
SSO_USERINFO_URL=https://sso.sovfhub.com/sso.userinfo.php
# Must exactly match one of the client's registered redirect_uris.
SSO_REDIRECT_URI=http://185.44.254.68:4000/portal/callback

# Electronic Trade Documents (admin only).
# Data directory for issued instruments and keys (default: data/etd, gitignored).
ETD_DIR=
# Ed25519 signing key as a PKCS8 PEM, with newlines written as the two characters \n.
# Keep it OUT of ETD_DIR in production. If unset, a key is generated into
# ETD_DIR/keys on first issue.
ETD_SIGNING_KEY=
