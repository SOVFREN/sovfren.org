---
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "The Sovfren Society is the vessel for Men & Women who seek knowledge, peace, and prosperity through fellowship, education and responsible stewardship.",
  image = "/images/og-image.png",
  noindex = false,
} = Astro.props;

const pageTitle = title.includes('Sovfren Society') ? title : `${title} · Sovfren Society`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sovfren Society',
  url: Astro.site?.toString(),
  logo: new URL('/images/crest.png', Astro.site).toString(),
  sameAs: ['https://sovfhub.com', 'https://sovfren.com'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sovfren Society" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1662d6" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --sf-primary: #1662d6;
        --sf-primary-strong: #0f4fb5;
        --sf-primary-soft: rgba(22, 98, 214, 0.1);
        --sf-ink: #0b1d3a;
        --sf-bg: #f4f7fb;
        --sf-surface: #ffffff;
        --sf-text: #0f172a;
        --sf-text-muted: #5f728c;
        --sf-border: rgba(15, 23, 42, 0.08);
        --sf-border-strong: rgba(15, 23, 42, 0.14);
        --sf-radius-md: 12px;
        --sf-radius-lg: 16px;
        --sf-radius-xl: 20px;
        --sf-radius-full: 9999px;
        --sf-shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.06);
        --sf-shadow: 0 24px 60px rgba(15, 23, 42, 0.09);
        --sf-shadow-lift: 0 30px 70px rgba(11, 29, 58, 0.14);
        --sf-font-display: 'Cormorant Garamond', 'Times New Roman', serif;
        --sf-font-body: Poppins, Helvetica, sans-serif;
        --sf-ease: cubic-bezier(0.22, 1, 0.36, 1);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--sf-bg);
        color: var(--sf-text);
        font-family: var(--sf-font-body);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      :focus-visible {
        outline: 2.5px solid var(--sf-primary);
        outline-offset: 3px;
        border-radius: 4px;
      }

      ::selection {
        background: var(--sf-primary);
        color: #ffffff;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: linear-gradient(115deg, #4aabf5 0%, #2f8ee8 55%, #1f6fd4 100%);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25) inset, 0 10px 30px rgba(15, 40, 90, 0.16);
      }

      nav {
        position: relative;
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 14px 24px;
      }

      .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        color: #ffffff;
        padding: 8px;
        margin: -8px;
        border-radius: var(--sf-radius-md);
        cursor: pointer;
        transition: background-color 0.15s var(--sf-ease);
      }

      .menu-toggle:hover {
        background: rgba(255, 255, 255, 0.14);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-weight: 600;
        font-size: 1.08rem;
        letter-spacing: 0.01em;
        color: #ffffff;
        flex-shrink: 0;
      }

      .brand img {
        width: 34px;
        height: 34px;
        object-fit: contain;
        background: #ffffff;
        border-radius: 50%;
        padding: 3px;
        box-shadow: 0 2px 8px rgba(11, 29, 58, 0.25);
      }

      .nav-links {
        display: flex;
      }

      .nav-links-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
      }

      .nav-links a {
        padding: 9px 15px;
        border-radius: var(--sf-radius-full);
        font-size: 0.9rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.88);
        transition: background-color 0.18s var(--sf-ease), color 0.18s var(--sf-ease);
        white-space: nowrap;
      }

      .nav-links a:hover {
        background: rgba(255, 255, 255, 0.16);
        color: #ffffff;
      }

      .nav-links a:active {
        background: rgba(255, 255, 255, 0.24);
      }

      @media (max-width: 960px) {
        .menu-toggle {
          display: flex;
        }

        .nav-links {
          display: grid;
          grid-template-rows: 0fr;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: #2168d0;
          box-shadow: var(--sf-shadow);
          transition: grid-template-rows 0.25s var(--sf-ease);
        }

        .nav-links.open {
          grid-template-rows: 1fr;
        }

        .nav-links-inner {
          flex-direction: column;
          gap: 0;
          padding: 4px 24px 12px;
          min-height: 0;
          overflow: hidden;
        }

        .nav-links a {
          padding: 13px 6px;
          border-radius: 0;
          border-top: 1px solid rgba(255, 255, 255, 0.14);
          font-size: 0.95rem;
        }

        .nav-links a:hover {
          background: rgba(255, 255, 255, 0.1);
        }
      }

      main {
        flex: 1 0 auto;
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 24px;
      }

      footer {
        flex-shrink: 0;
        margin-top: 72px;
        border-top: 1px solid var(--sf-border);
        background: var(--sf-surface);
        position: relative;
      }

      footer::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 72px;
        height: 3px;
        border-radius: var(--sf-radius-full);
        background: linear-gradient(90deg, var(--sf-primary), var(--sf-primary-strong));
      }

      .footer-inner {
        max-width: 1140px;
        margin: 0 auto;
        padding: 40px 24px 36px;
        text-align: center;
      }

      .footer-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
        font-family: var(--sf-font-display);
        font-weight: 600;
        font-size: 1.2rem;
        color: var(--sf-ink);
      }

      .footer-brand img {
        width: 24px;
        height: 24px;
        object-fit: contain;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px 4px;
        margin-bottom: 18px;
      }

      .footer-links a {
        padding: 6px 14px;
        border-radius: var(--sf-radius-full);
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--sf-text-muted);
        transition: background-color 0.15s var(--sf-ease), color 0.15s var(--sf-ease);
      }

      .footer-links a:hover {
        color: var(--sf-primary-strong);
        background: var(--sf-primary-soft);
      }

      .footer-copyright {
        margin: 0;
        font-size: 0.78rem;
        letter-spacing: 0.02em;
        color: var(--sf-text-muted);
      }

      /* ── shared content styles ─────────────────────────────────────
         :global() is required here: slotted page content isn't part of
         this component's own template, so Astro's scoped-CSS attribute
         selectors would otherwise never match it. ────────────────── */
      :global(.card) {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-xl);
        box-shadow: var(--sf-shadow-soft);
        padding: 52px 48px;
        margin: 32px 0;
      }

      :global(.card h1) {
        margin: 0 0 14px;
        font-family: var(--sf-font-display);
        font-size: clamp(2rem, 4.4vw, 2.9rem);
        font-weight: 700;
        line-height: 1.1;
        color: var(--sf-ink);
      }

      :global(.card h2) {
        margin: 44px 0 16px;
        font-family: var(--sf-font-display);
        font-size: clamp(1.4rem, 2.6vw, 1.65rem);
        font-weight: 700;
        line-height: 1.25;
        color: var(--sf-primary-strong);
      }

      :global(.card h2:first-child) {
        margin-top: 0;
      }

      :global(.card h3) {
        margin: 26px 0 8px;
        font-size: 1.08rem;
        font-weight: 600;
        color: var(--sf-text);
      }

      :global(.card p),
      :global(.card li) {
        margin: 0 0 16px;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--sf-text);
        max-width: 760px;
      }

      :global(.card ul) {
        margin: 0 0 16px;
        padding-left: 1.3em;
      }

      :global(.card li) {
        margin-bottom: 8px;
      }

      :global(.card a:not([class])) {
        color: var(--sf-primary-strong);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-color: var(--sf-primary-soft);
        text-underline-offset: 2px;
        transition: text-decoration-color 0.15s var(--sf-ease);
      }

      :global(.card a:not([class]):hover) {
        text-decoration-color: currentColor;
      }

      /* ── shared buttons ──────────────────────────────────────────── */
      :global(.btn) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--sf-primary);
        color: #ffffff;
        font-family: var(--sf-font-body);
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1;
        padding: 14px 26px;
        border: 1.5px solid transparent;
        border-radius: var(--sf-radius-full);
        box-shadow: 0 10px 24px rgba(22, 98, 214, 0.26);
        cursor: pointer;
        transition: background-color 0.18s var(--sf-ease), transform 0.18s var(--sf-ease), box-shadow 0.18s var(--sf-ease), opacity 0.18s var(--sf-ease);
      }

      :global(.btn:hover) {
        background: var(--sf-primary-strong);
        transform: translateY(-2px);
        box-shadow: 0 14px 30px rgba(22, 98, 214, 0.32);
      }

      :global(.btn:active) {
        transform: translateY(0);
      }

      :global(.btn-light) {
        background: #ffffff;
        color: var(--sf-primary-strong);
        box-shadow: 0 10px 24px rgba(11, 29, 58, 0.18);
      }

      :global(.btn-light:hover) {
        background: #ffffff;
        opacity: 0.94;
        box-shadow: 0 14px 30px rgba(11, 29, 58, 0.22);
      }

      :global(.btn-outline) {
        background: transparent;
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.65);
        box-shadow: none;
      }

      :global(.btn-outline:hover) {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.9);
        box-shadow: none;
      }

      :global(.btn-outline-dark) {
        background: transparent;
        color: var(--sf-primary-strong);
        border-color: var(--sf-primary-soft);
        box-shadow: none;
      }

      :global(.btn-outline-dark:hover) {
        background: var(--sf-primary-soft);
        box-shadow: none;
      }

      :global(.btn-small) {
        padding: 10px 20px;
        font-size: 0.88rem;
      }

      /* ── shared hero band ────────────────────────────────────────── */
      :global(.hero) {
        position: relative;
        margin: 32px 0;
        border-radius: var(--sf-radius-xl);
        overflow: hidden;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--sf-shadow-lift);
      }

      :global(.hero-content) {
        position: relative;
        max-width: 660px;
        text-align: center;
        padding: 56px 28px;
      }

      :global(.hero-kicker) {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: rgba(255, 255, 255, 0.85);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
      }

      :global(.hero-kicker::before),
      :global(.hero-kicker::after) {
        content: '';
        width: 22px;
        height: 1px;
        background: rgba(255, 255, 255, 0.5);
      }

      :global(.hero h1) {
        color: #ffffff;
        font-family: var(--sf-font-display);
        font-size: clamp(2.3rem, 5.6vw, 3.6rem);
        font-weight: 700;
        line-height: 1.08;
        text-align: center;
        margin: 0 0 20px;
      }

      :global(.hero-sub) {
        color: rgba(255, 255, 255, 0.92);
        font-size: 1.08rem;
        line-height: 1.65;
        margin: 0 0 32px;
      }

      :global(.hero-actions) {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* ── shared section heading ──────────────────────────────────── */
      :global(.section-heading) {
        text-align: center;
        max-width: 620px;
        margin: 0 auto 36px;
      }

      :global(.kicker) {
        margin: 0 0 8px;
        font-weight: 600;
        color: var(--sf-primary-strong);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.78rem;
      }

      :global(.section-heading h2) {
        margin: 0;
        font-family: var(--sf-font-display);
        font-size: clamp(1.7rem, 3.4vw, 2.2rem);
        font-weight: 700;
        line-height: 1.15;
        color: var(--sf-ink);
      }

      /* ── shared info-card grid (features / pillars / offerings) ───── */
      :global(.info-grid) {
        display: grid;
        grid-template-columns: repeat(var(--info-grid-cols, 4), 1fr);
        gap: 20px;
      }

      :global(.info-card) {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-lg);
        box-shadow: var(--sf-shadow-soft);
        padding: 30px 26px;
        transition: transform 0.2s var(--sf-ease), box-shadow 0.2s var(--sf-ease), border-color 0.2s var(--sf-ease);
      }

      :global(.info-card.is-link) {
        display: flex;
        flex-direction: column;
      }

      :global(a.info-card:hover) {
        transform: translateY(-3px);
        box-shadow: var(--sf-shadow);
        border-color: var(--sf-border-strong);
      }

      :global(.info-card h3) {
        margin: 0 0 10px;
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--sf-primary-strong);
      }

      :global(.info-card p) {
        margin: 0;
        font-size: 0.94rem;
        line-height: 1.6;
        color: var(--sf-text-muted);
        flex-grow: 1;
      }

      :global(.info-card .info-card-cta) {
        display: inline-block;
        margin-top: 16px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--sf-primary);
      }

      /* ── shared CTA band ─────────────────────────────────────────── */
      :global(.cta-band) {
        position: relative;
        text-align: center;
        overflow: hidden;
        background: linear-gradient(135deg, var(--sf-primary) 0%, var(--sf-primary-strong) 65%, #0c3a8c 100%);
        border-radius: var(--sf-radius-xl);
        padding: 60px 40px;
        margin: 60px 0 32px;
        box-shadow: var(--sf-shadow-lift);
      }

      :global(.cta-band h2) {
        margin: 0 0 14px;
        font-family: var(--sf-font-display);
        color: #ffffff;
        font-size: clamp(1.7rem, 3.6vw, 2.2rem);
        font-weight: 700;
      }

      :global(.cta-band p) {
        margin: 0 0 30px;
        color: rgba(255, 255, 255, 0.92);
        font-size: 1.05rem;
        max-width: 560px;
        margin-inline: auto;
      }

      :global(.cta-actions) {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      /* ── shared form controls ────────────────────────────────────── */
      :global(.card form) {
        margin: 24px 0 0;
      }

      :global(.card label) {
        display: block;
        margin: 0 0 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--sf-text);
        letter-spacing: 0.01em;
      }

      :global(.card input:not([type='checkbox']):not([type='radio'])),
      :global(.card select),
      :global(.card textarea) {
        width: 100%;
        font: inherit;
        font-size: 1rem;
        color: var(--sf-text);
        background: var(--sf-bg);
        padding: 13px 16px;
        border: 1.5px solid var(--sf-border);
        border-radius: var(--sf-radius-md);
        transition: border-color 0.15s var(--sf-ease), background-color 0.15s var(--sf-ease), box-shadow 0.15s var(--sf-ease);
      }

      :global(.card textarea) {
        resize: vertical;
        min-height: 120px;
      }

      :global(.card input:hover),
      :global(.card select:hover),
      :global(.card textarea:hover) {
        border-color: var(--sf-border-strong);
      }

      :global(.card input:focus),
      :global(.card select:focus),
      :global(.card textarea:focus) {
        outline: none;
        background: var(--sf-surface);
        border-color: var(--sf-primary);
        box-shadow: 0 0 0 4px var(--sf-primary-soft);
      }

      :global(.card form button),
      :global(.card form input[type='submit']) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 18px;
        background: var(--sf-primary);
        color: #ffffff;
        font-family: var(--sf-font-body);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 13px 26px;
        border: none;
        border-radius: var(--sf-radius-full);
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(22, 98, 214, 0.26);
        transition: background-color 0.18s var(--sf-ease), transform 0.18s var(--sf-ease);
      }

      :global(.card form button:hover),
      :global(.card form input[type='submit']:hover) {
        background: var(--sf-primary-strong);
        transform: translateY(-2px);
      }

      @media (max-width: 900px) {
        :global(.info-grid) {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 640px) {
        :global(.card) {
          padding: 34px 26px;
        }
        :global(.info-grid) {
          grid-template-columns: 1fr;
        }
        :global(.hero-content) {
          padding: 44px 22px;
        }
        :global(.cta-band) {
          padding: 44px 26px;
        }
      }

      @media (max-width: 420px) {
        :global(.card) {
          padding: 28px 20px;
        }
        nav {
          padding: 12px 16px;
        }
        main {
          padding: 0 16px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href="/">
          <img src="/images/logo-small.png" alt="Sovfren Society" />
          Sovfren Society
        </a>
        <div class="nav-links" id="nav-links">
          <div class="nav-links-inner">
            <a href="/vision">Vision</a>
            <a href="/sovfhub">Sovfhub</a>
            <a href="/register">Register</a>
            <a href="/property">Property</a>
            <a href="/public-notices">Public Notices</a>
            <a href="/portal">Companion Portal</a>
          </div>
        </div>
        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <a class="footer-brand" href="/">
          <img src="/images/logo-small.png" alt="" />
          Sovfren Society
        </a>
        <div class="footer-links">
          <a href="/founding-charter">Founding Charter</a>
          <a href="/sovfhub">Sovfhub</a>
          <a href="https://sovfren.com/contact/">Contact</a>
          <a href="/public-notices">Public Notices</a>
        </div>
        <p class="footer-copyright">&copy; Sovfren Society {new Date().getFullYear()}</p>
      </div>
    </footer>
    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const navLinks = document.getElementById('nav-links');

      menuToggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });

      navLinks?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          menuToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
