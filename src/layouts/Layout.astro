---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Sovfren Society</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --sf-primary: #1662d6;
        --sf-primary-strong: #0f4fb5;
        --sf-primary-soft: rgba(22, 98, 214, 0.1);
        --sf-bg: #f4f7fb;
        --sf-surface: #ffffff;
        --sf-text: #0f172a;
        --sf-text-muted: #5f728c;
        --sf-border: rgba(15, 23, 42, 0.08);
        --sf-radius-lg: 16px;
        --sf-radius-xl: 20px;
        --sf-radius-full: 9999px;
        --sf-shadow-soft: 0 12px 30px rgba(15, 23, 42, 0.06);
        --sf-shadow: 0 24px 60px rgba(15, 23, 42, 0.09);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--sf-bg);
        color: var(--sf-text);
        font-family: Poppins, Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #42a5f0;
        box-shadow: var(--sf-shadow-soft);
      }

      nav {
        position: relative;
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 14px 20px;
      }

      .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        color: #ffffff;
        padding: 6px;
        cursor: pointer;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 1.05rem;
        color: #ffffff;
      }

      .brand img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        background: #ffffff;
        border-radius: 50%;
        padding: 2px;
      }

      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
      }

      .nav-links a {
        padding: 8px 14px;
        border-radius: var(--sf-radius-full);
        font-size: 0.9rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .nav-links a:hover {
        background: rgba(255, 255, 255, 0.18);
        color: #ffffff;
      }

      @media (max-width: 768px) {
        .menu-toggle {
          display: flex;
        }

        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 0;
          background: #42a5f0;
          box-shadow: var(--sf-shadow);
          padding: 8px 20px 16px;
        }

        .nav-links.open {
          display: flex;
        }

        .nav-links a {
          padding: 12px 8px;
          border-radius: 0;
          border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .nav-links a:hover {
          background: rgba(255, 255, 255, 0.12);
        }
      }

      main {
        flex: 1 0 auto;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
      }

      footer {
        flex-shrink: 0;
        margin-top: 64px;
        border-top: 1px solid var(--sf-border);
        background: var(--sf-surface);
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px;
        text-align: center;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-bottom: 12px;
      }

      .footer-links a {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--sf-text-muted);
      }

      .footer-links a:hover {
        color: var(--sf-primary);
      }

      .footer-copyright {
        font-size: 0.8rem;
        color: var(--sf-text-muted);
      }

      /* ── shared content styles ─────────────────────────────────────
         :global() is required here: slotted page content isn't part of
         this component's own template, so Astro's scoped-CSS attribute
         selectors would otherwise never match it. ────────────────── */
      :global(.card) {
        background: var(--sf-surface);
        border: 1px solid var(--sf-border);
        border-radius: var(--sf-radius-xl);
        box-shadow: var(--sf-shadow-soft);
        padding: 48px 40px;
        margin: 32px 0;
      }

      :global(.card h1) {
        margin: 0 0 12px;
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 700;
        color: var(--sf-primary);
      }

      :global(.card h2) {
        margin: 40px 0 16px;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--sf-primary);
      }

      :global(.card h2:first-child) {
        margin-top: 0;
      }

      :global(.card h3) {
        margin: 24px 0 8px;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--sf-text);
      }

      :global(.card p),
      :global(.card li) {
        margin: 0 0 16px;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--sf-text);
        max-width: 760px;
      }

      :global(.card ul) {
        margin: 0 0 16px;
        padding-left: 1.3em;
      }

      :global(.card li) {
        margin-bottom: 8px;
      }

      @media (max-width: 640px) {
        :global(.card) {
          padding: 32px 24px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href="/">
          <img src="/images/logo-small.png" alt="Sovfren Society" />
          Sovfren Society
        </a>
        <div class="nav-links" id="nav-links">
          <a href="/vision">Vision</a>
          <a href="/register">Register</a>
          <a href="/property">Property</a>
          <a href="/public-notices">Public Notices</a>
          <a href="/portal">Companion Portal</a>
        </div>
        <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-links">
          <a href="/founding-charter">Founding Charter</a>
          <a href="https://sovfhub.com">SovfHub</a>
          <a href="https://sovfren.com/contact/">Contact</a>
          <a href="/public-notices">Public Notices</a>
        </div>
        <p class="footer-copyright">&copy; Sovfren Society {new Date().getFullYear()}</p>
      </div>
    </footer>
    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const navLinks = document.getElementById('nav-links');

      menuToggle?.addEventListener('click', () => {
        const isOpen = navLinks?.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });

      navLinks?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('open');
          menuToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
