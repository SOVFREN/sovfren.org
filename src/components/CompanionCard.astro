---
import { code128B } from '../lib/barcode';

// Certificate of the Identity card, laid out on the reference design's
// 1016x638 grid. `standard` carries Sovfren marks only; `prototype` adds the
// diplomatic elements from the design under review and a PROTOTYPE watermark.
interface Props {
  variant?: 'standard' | 'prototype';
  name: string;
  companionNumber?: string | null;
  status?: 'valid' | 'expired' | 'revoked';
  title?: string | null;
  sendingState?: string | null;
  aol?: string | null;
  expiryDate?: string | null;
  photoUrl?: string | null;
  qrCodeDataUrl?: string | null;
  sealUrl?: string | null;
  heraldryUrl?: string | null;
  signatureUrl?: string | null;
}

const {
  variant = 'standard',
  name,
  companionNumber,
  status = 'valid',
  title,
  sendingState,
  aol,
  expiryDate,
  photoUrl,
  qrCodeDataUrl,
  sealUrl,
  heraldryUrl,
  signatureUrl,
} = Astro.props;

const proto = variant === 'prototype';
const barcode = companionNumber ? code128B(companionNumber) : null;
---
<div class="flip" data-flip>
  <div class="flip-inner">
    <!-- FRONT -->
    <div class="face front">
      {proto ? (
        <img class="px flag" src="/images/prototype/flag.png" alt="" />
      ) : (
        <img class="px flag crest" src="/images/logo-small.png" alt="" />
      )}
      <div class="px t-title">CERTIFICATE OF THE IDENTITY</div>
      <div class="px t-sub">
        {proto ? 'Issued under the law of England & Wales' : 'Issued by The Sovfren Society'}
      </div>
      <div class="px t-class">{proto ? 'DIPLOMATIC' : 'COMPANION'}</div>

      <div class="px white panel"></div>
      <div class="px fields">
        <div><b>Name:</b> {name}</div>
        {proto ? (
          <>
            <div><b>Title:</b> {title}</div>
            <div><b>Sending State:</b> {sendingState}</div>
            <div><b>POL</b>-{companionNumber}</div>
            <div><b>AOL</b>-{aol}</div>
          </>
        ) : (
          <>
            {title && <div><b>Title:</b> {title}</div>}
            <div><b>Status:</b> <span class={`st-${status}`}>{status.toUpperCase()}</span></div>
            {expiryDate && <div><b>Expires:</b> {expiryDate}</div>}
            <div><b>SOV</b>-{companionNumber ?? '—'}</div>
          </>
        )}
      </div>
      {proto && <img class="px stamp" src="/images/prototype/stamp.png" alt="" />}
      <div class="px photo">
        {photoUrl ? <img src={photoUrl} alt="" /> : <span>No Photo</span>}
      </div>

      <div class="px white lower"></div>
      {qrCodeDataUrl && <img class="px qr" src={qrCodeDataUrl} alt="Scan to view public Register record" />}
      <div class="px sig wide">
        {signatureUrl ? <img src={signatureUrl} alt="Autograph" /> : name}
      </div>
      {barcode && (
        <svg
          class="px barcode wide"
          viewBox={`0 0 ${barcode.width} 40`}
          preserveAspectRatio="none"
          aria-label={`Barcode for ${companionNumber}`}
        >
          {barcode.bars.map((b) => <rect x={b.x} y="0" width={b.width} height="40" />)}
        </svg>
      )}
      {proto ? (
        sealUrl && <img class="px seal" src={sealUrl} alt="Private seal" />
      ) : (
        <img class="px seal" src="/images/crest.png" alt="" />
      )}
      <div class="px foot">This Certificate of the identity is registered with The Sovfren Society</div>
      {proto && <div class="mark">PROTOTYPE — NOT VALID</div>}
    </div>

    <!-- BACK -->
    <div class="face back">
      {proto ? (
        <>
          <div class="px b-head">Declared by his majesty's royal charters &amp; letters patent 1835</div>
          <p class="px b-text">
            For the knowledge of the Federation Trust, the Universal Law Commission and all global civil
            authorities: I am a free and living man, a universal declaration of the human rights holder,
            union member under assembly and diplomatic privileges (UPU Order). Status declared: Free
            inhabitant; not a corporation, debtor, surety, or trustee. Not a vessel, transmitting
            utility, or legal fiction. Not subject to statutory jurisdiction where no lawful contract
            exists. No consent to administrative or commercial presumptions. No joinder with any
            artificial person bearing a similar name. All rights reserved without prejudice No liability
            accepted without full disclosure and verified claim. Notice to agents is notice to
            principals; notice to principals is notice to agents. Any claim must be supported by sworn
            affidavit and wet-ink contract. Public record: Unlawful claims are rejected. Silent
            acquiescence is denied. Any commercial instrument sent without proof of claim constitutes
            fraud and dishonour. All matters must be settled in equity under natural law. Union member
            under Diplomatic Privileges (UPU Order).
          </p>
          <img class="px un" src="/images/prototype/un.png" alt="" />
          {heraldryUrl && <img class="px arms" src={heraldryUrl} alt="Private estate heraldry" />}
          <img class="px ems" src="/images/prototype/ems.png" alt="" />
          <img class="px stripes" src="/images/prototype/ems-stripes.png" alt="" />
          <div class="px care">Aux soins du Consul d'<br />{sendingState}</div>
          <div class="mark">PROTOTYPE — NOT VALID</div>
        </>
      ) : (
        <>
          <div class="px b-head">Sovfren Society · Companion Declaration</div>
          <p class="px b-text">
            This card identifies the named Companion of the Sovfren Society. The holder declares
            themselves a free and living person, acting in their own name and on their own
            responsibility. All rights are reserved without prejudice. The authenticity of this card
            and the standing of its holder may be checked at any time by scanning the QR code on the
            front or by visiting sovfren.org/register and entering the Companion Number.
          </p>
          <img class="px crest-back" src="/images/crest.png" alt="" />
          <div class="px care">
            <b>The Sovfren Society</b><br />sovfren.org/register<br />{companionNumber}
          </div>
        </>
      )}
    </div>
  </div>
  <button type="button" class="flip-btn" data-flip-btn>Flip card</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-flip]').forEach((el) => {
    const toggle = () => el.classList.toggle('flipped');
    el.querySelector('.flip-inner')?.addEventListener('click', toggle);
    el.querySelector('[data-flip-btn]')?.addEventListener('click', toggle);
  });
</script>

<style>
  .flip {
    max-width: 800px;
    perspective: 1600px;
    container-type: inline-size;
    margin-bottom: 8px;
  }

  .flip-inner {
    position: relative;
    aspect-ratio: 1016 / 638;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--sf-ease);
    cursor: pointer;
  }

  .flip.flipped .flip-inner { transform: rotateY(180deg); }

  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    border-radius: 1.6cqw;
    background: linear-gradient(180deg, #4aa3e0 0%, #2d8fd6 100%);
    color: #fff;
    box-shadow: var(--sf-shadow);
    font-family: Arial, Helvetica, sans-serif;
  }

  .back { transform: rotateY(180deg); }
  .px { position: absolute; }
  .white { background: #fff; }

  /* Geometry is the reference design's pixel grid as % of the 1016x638 card;
     font sizes are cqw (1cqw = 1% of card width). */
  .flag { left: 3.74%; top: 4.39%; width: 26.97%; height: 19.59%; object-fit: cover; }
  .flag.crest { object-fit: contain; background: #fff; padding: 1cqw; box-sizing: border-box; }
  .t-title { right: 5.5%; top: 4.1%; font-family: 'Arial Narrow', 'Liberation Sans Narrow', Arial, sans-serif; font-stretch: condensed; font-size: 4.3cqw; letter-spacing: -0.03em; white-space: nowrap; }
  .t-sub { right: 5.5%; top: 13.2%; font-size: 1.8cqw; white-space: nowrap; }
  .t-class { right: 5.5%; top: 17.2%; font-family: 'Arial Narrow', 'Liberation Sans Narrow', Arial, sans-serif; font-stretch: condensed; font-size: 3.45cqw; }
  .panel { left: 3.74%; top: 23.98%; width: 91.34%; height: 36.36%; }
  .fields { left: 4.7%; top: 23.98%; width: 44%; color: #111; font-size: 3cqw; line-height: 1.1; padding-top: 0.4cqw; }
  .fields div { overflow-wrap: anywhere; }
  .st-valid { color: #12803a; }
  .st-expired { color: #b45309; }
  .st-revoked { color: #b91c1c; }
  .stamp { left: 48.7%; top: 29.8%; width: 20.2%; height: 28.2%; }
  .photo { left: 69.98%; top: 23.98%; width: 25.1%; height: 36.36%; background: #cfd9e4; color: #5f728c; display: flex; align-items: center; justify-content: center; font-size: 2.4cqw; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .lower { left: 3.74%; top: 60.34%; width: 91.34%; height: 29.78%; }
  .qr { left: 3.74%; top: 63.95%; width: 15.75%; height: 25.08%; object-fit: contain; }
  .sig { left: 28.54%; top: 63.95%; width: 40.85%; height: 12.85%; display: flex; align-items: center; color: #1d3fa0; font-family: 'Segoe Script', 'Brush Script MT', cursive; font-size: 3.2cqw; background: #f3f6fa; white-space: nowrap; overflow: hidden; }
  .sig img { width: 100%; height: 100%; object-fit: contain; }
  .sig.wide { left: 21.5%; width: 47.9%; }
  .barcode { left: 22.14%; top: 77.9%; width: 46.26%; height: 10.19%; fill: #111; }
  .barcode.wide { left: 21.5%; width: 47.9%; }
  .seal { left: 74.31%; top: 60.34%; width: 20.67%; height: 29.78%; object-fit: contain; }
  .foot { left: 0; right: 0; top: 90.6%; text-align: center; font-size: 1.8cqw; }

  .b-head { left: 0; right: 0; top: 8.1%; text-align: center; font-size: 2.95cqw; }
  .b-text { left: 4.04%; top: 15.4%; width: 92.13%; height: 47.96%; margin: 0; box-sizing: border-box; padding: 0.8cqw 0.9cqw; background: #fff; color: #111; font-size: 2.0cqw; line-height: 1.42; }
  .un { left: 3.74%; top: 70.2%; width: 15.45%; height: 24.6%; }
  .arms { object-fit: contain; left: 22.15%; top: 68.2%; width: 14.76%; height: 25.9%; }
  .ems { left: 37.9%; top: 78.4%; width: 37.5%; height: 16%; }
  .stripes { left: 75.6%; top: 79.2%; width: 19.1%; height: 6.7%; }
  .care { left: 75.4%; top: 87.2%; font-size: 1.97cqw; line-height: 1.15; }
  .crest-back { left: 3.74%; top: 70.2%; width: 15.45%; height: 24.6%; object-fit: contain; background: #fff; padding: 1cqw; box-sizing: border-box; }
  .crest-back + .care { left: 22%; top: 76%; font-size: 3cqw; line-height: 1.3; }

  .mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-18deg);
    font-size: 5.5cqw;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: rgba(190, 20, 20, 0.35);
    text-shadow: 0 0 0.4cqw rgba(255, 255, 255, 0.6);
    pointer-events: none;
    white-space: nowrap;
  }

  .flip-btn {
    margin-top: 12px;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    color: var(--sf-text-muted);
    text-decoration: underline;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-inner { transition: none; }
  }
</style>
