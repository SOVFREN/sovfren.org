---
// The instrument as a formal document. Two templates (Promissory Note, Bill of
// Exchange) share one layout and differ in wording and accent colour. The text of
// the promise is generated from the signed, structured terms. The signed record
// in the registry is what governs; this is only how it is presented.
import type { Instrument, State, Party } from '../lib/etd';
import { amountInWords } from '../lib/amount-words';
import { maturityValue, perDiem, splitPayable } from '../lib/maturity';

interface Props {
  inst: Instrument;
  state?: State;
  verified: boolean;
  qr: string; // data URL
  mode?: 'screen' | 'print';
}
const { inst, state, verified, qr, mode = 'screen' } = Astro.props;
const t = inst.terms;
const isNote = t.type === 'promissory_note';
const title = isNote ? 'Promissory Note' : 'Bill of Exchange';
const status = state?.status ?? 'active';

const money = (v: string) => {
  const [int, dec = '00'] = v.split('.');
  return `${int.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}.${dec.padEnd(2, '0')}`;
};
const longDate = (d: string) =>
  /^\d{4}-\d{2}-\d{2}$/.test(d)
    ? new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
    : d;

const pay = splitPayable(t.payableOn);
const onDemand = pay.onDemand;
const payText = onDemand
  ? 'On demand'
  : `${longDate(pay.date ?? t.payableOn)}${pay.time ? ` at ${pay.time}${t.payableTz ? ` (${t.payableTz})` : ''}` : ''}`;
const when = onDemand ? 'On demand' : `On ${payText}`;
const dayCount = t.dayCount ?? 'ACT/365';
// Instruments with no fixed maturity: indicative value today (interest has been building since issue).
const todayStr = new Date().toISOString().slice(0, 10);
const accrued =
  t.interestRate && onDemand && state?.status === 'active' && todayStr >= t.issuedAt
    ? maturityValue(t.amount, t.interestRate, dayCount, t.issuedAt, todayStr)
    : null;
const daily = t.interestRate && onDemand ? perDiem(t.amount, t.interestRate, dayCount) : null;
const endorsements = inst.events.filter((e) => e.type === 'transfer');
const sum = `${t.currency} ${money(t.amount)}`;
// The words sealed at issue; early instruments without them get the same wording computed on the fly.
const words = t.amountWords ?? amountInWords(t.amount, t.currency);
const payee = state?.holder ?? t.payee;
const sub = (p?: Party) => [p?.ref, p?.lei ? `LEI ${p.lei}` : '', p?.bic ? `BIC ${p.bic}` : ''].filter(Boolean).join(' · ');

const statusLabel = !verified ? 'Failed verification' : status === 'active' ? 'Active' : status === 'paid' ? 'Paid' : 'Cancelled';
const stamp = !verified ? 'Do not rely' : status === 'paid' ? 'Paid' : status === 'cancelled' ? 'Cancelled' : null;
---
<article class={`doc ${isNote ? 'note' : 'bill'} ${mode}`} aria-label={`${title} ${t.serial}`}>
  <div class="frame">
    <header class="head">
      <div class="issuer">
        <img src="/images/crest.png" alt="" width="34" height="34" />
        <span>Sovfren Society · Electronic Trade Register</span>
      </div>
      <h2>{title}</h2>
      <p class="serial">No. {t.serial}</p>
      <span class={`status ${verified ? status : 'failed'}`}>{statusLabel}</span>
    </header>

    <div class="amount">
      <span class="label">The sum of</span>
      <span class="fig"><span class="cur">{t.currency}</span> {money(t.amount)}</span>
      {words && <span class="words"><span class="label">Amount in words</span>{words}</span>}
    </div>

    <p class="clause">
      {isNote ? (
        <>
          {when}, I, <strong>{t.maker?.name}</strong>, promise to pay to the order of <strong>{t.payee.name}</strong> the sum
          of <strong>{sum}</strong>{words ? <> (<em>{words}</em>)</> : null}{t.interest ? <>, together with interest as follows: {t.interest}</> : null}.
        </>
      ) : (
        <>
          {onDemand ? 'At sight' : when}, pay this Bill of Exchange to the order of <strong>{t.payee.name}</strong> the sum
          of <strong>{sum}</strong>{words ? <> (<em>{words}</em>)</> : null}{t.interest ? <>, together with interest as follows: {t.interest}</> : null}.
          Drawn by <strong>{t.drawer?.name}</strong> upon <strong>{t.drawee?.name}</strong>{state?.accepted ? ', who has accepted it' : ''}.
        </>
      )}
    </p>

    <dl class="parties">
      {isNote ? (
        <div><dt>Maker</dt><dd>{t.maker?.name}<small>{sub(t.maker)}</small></dd></div>
      ) : (
        <>
          <div><dt>Drawer</dt><dd>{t.drawer?.name}<small>{sub(t.drawer)}</small></dd></div>
          <div><dt>Drawee {state?.accepted ? '(accepted)' : ''}</dt><dd>{t.drawee?.name}<small>{sub(t.drawee)}</small></dd></div>
        </>
      )}
      <div><dt>Original payee</dt><dd>{t.payee.name}<small>{sub(t.payee)}</small></dd></div>
    </dl>

    <dl class="terms">
      <div><dt>Issued</dt><dd>{longDate(t.issuedAt)}</dd></div>
      <div><dt>Place</dt><dd>{t.placeOfIssue}</dd></div>
      <div><dt>Payable</dt><dd>{payText}</dd></div>
      {t.governingLaw && <div><dt>Governing law</dt><dd>{t.governingLaw}</dd></div>}
      {t.identifiers && Object.entries(t.identifiers).map(([k, v]) => <div><dt>{k.toUpperCase()}</dt><dd class="mono">{v}</dd></div>)}
    </dl>

    {t.interestRate && (
      <section class="value">
        <span class="label">{t.maturityValue ? 'Value at maturity' : 'Interest'}</span>
        {t.maturityValue ? (
          <>
            <dl class="calc">
              <div><dt>Principal</dt><dd>{t.currency} {money(t.amount)}</dd></div>
              <div><dt>Interest at {t.interestRate}% a year · {t.interestDays} days · {dayCount}</dt><dd>{t.currency} {money(t.interestAtMaturity ?? '0')}</dd></div>
              <div class="total"><dt>Due at maturity</dt><dd>{t.currency} {money(t.maturityValue)}</dd></div>
            </dl>
            {t.maturityValueWords && <p class="vwords">{t.maturityValueWords}</p>}
          </>
        ) : (
          <p class="accrue">
            Interest accrues at {t.interestRate}% a year ({dayCount}, simple) from the issue date until paid{daily ? `, about ${t.currency} ${money(daily)} a day` : null}.
            {accrued && accrued.days > 0 && <> Indicative value today: <strong>{t.currency} {money(accrued.total)}</strong> ({accrued.days} days). The amount due is calculated on the day of payment.</>}
          </p>
        )}
      </section>
    )}

    {endorsements.length > 0 && (
      <section class="endorse">
        <span class="label">Endorsements</span>
        <ol>
          {endorsements.map((e) => {
            const d = e.data as { from: Party; to: Party };
            return <li><strong>{d.from.name}</strong> to <strong>{d.to.name}</strong><small>{e.at.slice(0, 10)} · signed by the holder's key</small></li>;
          })}
        </ol>
      </section>
    )}

    {t.clauses && <p class="clauses"><span class="label">Additional terms</span>{t.clauses}</p>}

    <footer class="foot">
      <div class="holder">
        <span class="label">Held by</span>
        <strong>{payee.name}</strong>
        {sub(payee) && <small>{sub(payee)}</small>}
        <small class="deliv">
          {state?.delivered ? `Delivered ${state.delivered.at.slice(0, 10)} (${state.delivered.method})` : status === 'active' ? 'Not yet delivered to this holder' : ''}
        </small>
      </div>
      <div class="seal">
        <img src={qr} alt="QR code to this instrument's live registry record" width="96" height="96" />
        <div>
          <span class="label">{verified ? 'Registry verified' : 'Verification failed'}</span>
          <small class="mono">ID {inst.id.slice(0, 16)}…</small>
          <small class="mono">Key {inst.kid}</small>
        </div>
      </div>
    </footer>

    <p class="fineprint">
      {mode === 'print'
        ? 'Information copy only. Holding or presenting this page confers no rights. The registry record is the original; check its live status before relying on this.'
        : 'This is a presentation of the signed record. The registry record is the original, and only the holder it names can transfer it.'}
    </p>

    {stamp && <div class={`stamp ${verified ? status : 'failed'}`} aria-hidden="true">{stamp}</div>}
    {mode === 'print' && <div class="copy" aria-hidden="true">COPY</div>}
  </div>
</article>

<style>
  .doc {
    --accent: #0b1d3a;
    --accent-rgb: 11, 29, 58;
    --gold: #b08d3c;
    --paper: #fffdf8;
    position: relative;
    color: #1b2433;
    background: var(--paper);
    border-radius: 10px;
    padding: clamp(8px, 2vw, 14px);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12), 0 2px 6px rgba(15, 23, 42, 0.06);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .doc.bill { --accent: #0e5a45; --accent-rgb: 14, 90, 69; }
  .doc.print { box-shadow: none; border-radius: 0; }

  .frame {
    position: relative;
    overflow: hidden;
    padding: clamp(18px, 4.5vw, 44px);
    border: 1px solid var(--gold);
    box-shadow: inset 0 0 0 5px var(--paper), inset 0 0 0 6px var(--accent);
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb), 0.05), transparent 55%),
      var(--paper);
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/crest.png') center 58% / min(46%, 280px) no-repeat;
    opacity: 0.045;
    pointer-events: none;
  }
  .frame > :not(.stamp):not(.copy) { position: relative; }

  .label {
    display: block;
    font: 600 0.66rem/1.2 var(--sf-font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.8;
    margin-bottom: 4px;
  }
  small { display: block; font-size: 0.74rem; color: #5b6676; line-height: 1.4; }
  .mono { font-family: ui-monospace, Menlo, Consolas, monospace; }

  /* head */
  .head { text-align: center; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid rgba(var(--accent-rgb), 0.2); position: relative; }
  .head::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 8px;
    height: 8px;
    background: var(--gold);
    transform: translateX(-50%) rotate(45deg);
  }
  .issuer { display: inline-flex; align-items: center; gap: 10px; font: 600 0.66rem/1.3 var(--sf-font-body); letter-spacing: 0.18em; text-transform: uppercase; color: #5b6676; margin-bottom: 10px; text-align: left; }
  .issuer img { width: 34px; height: 34px; object-fit: contain; }
  h2 {
    font-family: var(--sf-font-display);
    font-size: clamp(2rem, 7vw, 3.1rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin: 0;
    color: var(--accent);
  }
  .serial { margin: 6px 0 12px; font: 500 0.82rem var(--sf-font-body); letter-spacing: 0.08em; color: #5b6676; }
  .status { display: inline-block; padding: 4px 14px; border-radius: 999px; font: 600 0.7rem var(--sf-font-body); letter-spacing: 0.1em; text-transform: uppercase; }
  .status.active { background: rgba(15, 122, 61, 0.1); color: #0b5a2d; }
  .status.paid { background: rgba(22, 98, 214, 0.1); color: #0f4fb5; }
  .status.cancelled, .status.failed { background: rgba(179, 38, 30, 0.1); color: #8c1d18; }

  /* amount */
  .amount {
    text-align: center;
    padding: 18px 12px;
    margin-bottom: 20px;
    border: 1px solid rgba(var(--accent-rgb), 0.22);
    background:
      repeating-radial-gradient(circle at 12% 50%, transparent 0 7px, rgba(var(--accent-rgb), 0.07) 7px 8px),
      repeating-radial-gradient(circle at 88% 50%, transparent 0 7px, rgba(var(--accent-rgb), 0.07) 7px 8px),
      rgba(var(--accent-rgb), 0.03);
  }
  .amount .label { text-align: center; }
  .fig { font-family: var(--sf-font-display); font-size: clamp(2.1rem, 8vw, 3.4rem); font-weight: 700; line-height: 1.05; color: var(--accent); font-variant-numeric: tabular-nums; word-break: break-all; }
  .words { display: block; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(var(--accent-rgb), 0.2); font-family: var(--sf-font-display); font-size: clamp(1.15rem, 3.6vw, 1.5rem); font-weight: 600; font-style: italic; line-height: 1.3; color: var(--accent); }
  .words .label { text-align: center; font-style: normal; }
  .cur { font-size: 0.55em; font-weight: 600; letter-spacing: 0.06em; margin-right: 4px; }

  /* clause */
  .clause { font-family: var(--sf-font-display); font-size: clamp(1.1rem, 3.4vw, 1.4rem); line-height: 1.5; margin: 0 0 22px; text-align: center; color: #1b2433; }
  .clause strong { color: var(--accent); font-weight: 700; }

  /* parties + terms */
  dl { margin: 0; }
  dt { font: 600 0.66rem/1.2 var(--sf-font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); opacity: 0.8; margin-bottom: 4px; }
  dd { margin: 0; font-weight: 600; font-size: 0.95rem; word-break: break-word; }
  .parties { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; padding: 16px 0; border-top: 1px solid rgba(var(--accent-rgb), 0.15); }
  .terms { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 14px 16px; padding: 16px 0; border-top: 1px solid rgba(var(--accent-rgb), 0.15); }
  .terms dd { font-weight: 500; font-size: 0.9rem; }
  .value, .endorse { padding: 16px 0; border-top: 1px solid rgba(var(--accent-rgb), 0.15); }
  .calc { display: grid; gap: 6px; max-width: 460px; }
  .calc > div { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  .calc dt { margin: 0; font: 400 0.8rem var(--sf-font-body); letter-spacing: 0; text-transform: none; color: #3b4658; opacity: 1; }
  .calc dd { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .calc .total { border-top: 1px solid var(--accent); padding-top: 8px; margin-top: 4px; }
  .calc .total dt { font-weight: 600; color: var(--accent); }
  .calc .total dd { font-family: var(--sf-font-display); font-size: 1.35rem; font-weight: 700; color: var(--accent); }
  .vwords { margin: 8px 0 0; font-family: var(--sf-font-display); font-style: italic; font-weight: 600; font-size: 1.1rem; color: var(--accent); }
  .accrue { margin: 0; font-size: 0.88rem; line-height: 1.5; }
  .endorse ol { margin: 0; padding-left: 1.2em; font-size: 0.9rem; }
  .endorse li { margin-bottom: 4px; }
  .clauses { white-space: pre-wrap; font-size: 0.88rem; padding: 14px 0; border-top: 1px solid rgba(var(--accent-rgb), 0.15); margin: 0; }

  /* footer */
  .foot { display: flex; flex-wrap: wrap; gap: 18px 28px; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 2px solid var(--accent); margin-top: 6px; }
  .holder { min-width: 180px; flex: 1 1 200px; }
  .holder strong { font-family: var(--sf-font-display); font-size: 1.35rem; color: var(--accent); }
  .deliv { margin-top: 4px; }
  .seal { display: flex; align-items: center; gap: 12px; }
  .seal img { border: 1px solid rgba(var(--accent-rgb), 0.2); padding: 4px; background: #fff; border-radius: 6px; }
  .fineprint { margin: 18px 0 0; font-size: 0.7rem; line-height: 1.5; color: #7a8493; text-align: center; }

  /* stamps */
  .stamp {
    position: absolute;
    top: 38%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-14deg);
    padding: 6px 28px;
    border: 5px double currentColor;
    border-radius: 8px;
    font: 700 clamp(1.6rem, 8vw, 3.2rem) var(--sf-font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.2;
    pointer-events: none;
    white-space: nowrap;
  }
  .stamp.paid { color: #0f4fb5; }
  .stamp.cancelled, .stamp.failed { color: #b3261e; opacity: 0.28; }
  .copy {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 700 clamp(5rem, 24vw, 11rem) var(--sf-font-body);
    letter-spacing: 0.12em;
    color: rgba(179, 38, 30, 0.07);
    transform: rotate(-28deg);
    pointer-events: none;
  }
  @media (max-width: 480px) {
    .seal { width: 100%; }
    .parties { grid-template-columns: 1fr; }
  }
</style>
