---
import Layout from '../../layouts/Layout.astro';

const companionNumber = Astro.url.searchParams.get('companion_number')?.trim();
if (companionNumber) {
  return Astro.redirect(`/register/${encodeURIComponent(companionNumber)}`);
}
---
<Layout
  title="Register"
  description="Look up a Companion's Proof of Life record in the Sovfren Society Register by Companion Number."
>
  <h1>Register of Companions</h1>
  <p>Look up a companion's Proof of Life record by Companion Number.</p>
  <form action="/register" method="get">
    <label for="companion_number">Companion Number</label>
    <input id="companion_number" name="companion_number" placeholder="SovfCom00000001" required />
    <button type="submit">Look up</button>
  </form>
</Layout>
