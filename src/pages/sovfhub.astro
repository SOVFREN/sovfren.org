---
import Layout from '../layouts/Layout.astro';

const features = [
  ['Communication & Collaboration', 'Message and collaborate with Companions across the Society in a private digital environment.'],
  ['Education', 'Access courses, resources and learning initiatives created for Companions.'],
  ['Communities & Societies', 'Establish communities, societies, projects and brands alongside fellow Companions.'],
  ['Register & Notices', 'Access the Register of Companions, constitutional notices and digital certificates.'],
  ['Opportunities & Appointments', 'Discover Constitutional Offices, Stewardship roles, projects and engagements open to Companions.'],
  ['Constitutional Administration', 'Participate in admissions, constitutional communications, voting and the governance of the Society.'],
];
---
<Layout
  title="Sovfhub"
  description="Sovfhub is the official digital institution of the Sovfren Society — a private platform for communication, education, collaboration, commerce and constitutional administration."
>
  <section class="hero">
    <div class="hero-content">
      <p class="hero-kicker">A Constitutional Institution of the Sovfren Society</p>
      <h1>Sovfhub</h1>
      <p class="hero-sub">
        The Society's digital home&mdash;where Companions communicate, learn, collaborate,
        build communities and enterprises, and take part in the constitutional life of
        the Sovfren Society.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href="https://sovfhub.com">Visit Sovfhub →</a>
        <a class="btn btn-outline" href="/sovfhub-charter">Read the Charter of Sovfhub</a>
      </div>
    </div>
  </section>

  <section class="card intro-card">
    <p class="lead">
      Sovfhub is established as a permanent Constitutional Institution of the Sovfren
      Society, providing a private digital environment through which Companions may
      communicate, learn, collaborate, establish communities and societies, develop
      brands and enterprises, participate in constitutional governance and access the
      institutions of the Society.
    </p>
  </section>

  <section class="features-section">
    <div class="section-heading">
      <p class="kicker">What You Can Do</p>
      <h2>One Platform, Many Purposes</h2>
    </div>
    <div class="features-grid">
      {features.map(([term, text]) => (
        <div class="feature-card">
          <h3>{term}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="card stewardship-card">
    <h2>Governed With Integrity</h2>
    <p>
      Sovfhub operates under the constitutional oversight of the Principal Guardian,
      the Council of Guardians and authorised Constitutional Officers. The information,
      technology and digital resources entrusted to Sovfhub form part of the Society's
      Common Estate, and are administered with integrity, Good Conscience and faithful
      Stewardship.
    </p>
    <a class="link-arrow" href="/sovfhub-charter">Read the full Charter of Sovfhub →</a>
  </section>

  <section class="cta-band">
    <h2>Join Sovfhub</h2>
    <p>Become a Companion of the Sovfren Society to access Sovfhub's communities, education, commerce and constitutional life.</p>
    <div class="cta-actions">
      <a class="btn btn-light" href="/register">Become a Companion</a>
      <a class="btn btn-outline-dark" href="https://sovfhub.com">Visit Sovfhub →</a>
    </div>
  </section>
</Layout>

<style>
  .card {
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-xl);
    box-shadow: var(--sf-shadow-soft);
    padding: 48px 40px;
    margin: 32px 0;
  }

  .hero {
    position: relative;
    margin: 32px 0;
    border-radius: var(--sf-radius-xl);
    overflow: hidden;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1662d6 0%, #0f4fb5 60%, #14276d 100%);
    box-shadow: var(--sf-shadow);
  }

  .hero-content {
    position: relative;
    max-width: 640px;
    text-align: center;
    padding: 0 24px;
  }

  .hero-kicker {
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero h1 {
    color: #ffffff;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 16px;
  }

  .hero-sub {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 28px;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .intro-card {
    text-align: center;
  }

  .lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--sf-text);
  }

  .section-heading {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 32px;
  }

  .kicker {
    margin: 0 0 6px;
    font-weight: 600;
    color: var(--sf-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--sf-primary);
  }

  .features-section {
    margin: 56px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-lg);
    box-shadow: var(--sf-shadow-soft);
    padding: 28px 24px;
  }

  .feature-card h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sf-primary);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--sf-text-muted);
  }

  .stewardship-card h2 {
    margin: 0 0 16px;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sf-primary);
  }

  .stewardship-card p {
    max-width: 720px;
    color: var(--sf-text);
    font-size: 1.02rem;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .link-arrow {
    display: inline-block;
    color: var(--sf-primary);
    font-weight: 600;
  }

  .cta-band {
    text-align: center;
    background: linear-gradient(135deg, var(--sf-primary) 0%, var(--sf-primary-strong) 100%);
    border-radius: var(--sf-radius-xl);
    padding: 56px 40px;
    margin: 56px 0 32px;
    box-shadow: var(--sf-shadow);
  }

  .cta-band h2 {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .cta-band p {
    margin: 0 0 28px;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.05rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    background: var(--sf-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: var(--sf-radius-full);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn:hover {
    background: var(--sf-primary-strong);
    transform: translateY(-1px);
  }

  .btn-light {
    background: #ffffff;
    color: var(--sf-primary-strong);
  }

  .btn-light:hover {
    background: #ffffff;
    transform: translateY(-1px);
    opacity: 0.92;
  }

  .btn-outline {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  .btn-outline-dark {
    background: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
  }

  .btn-outline-dark:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .card {
      padding: 32px 24px;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
    .cta-band {
      padding: 40px 24px;
    }
  }
</style>
