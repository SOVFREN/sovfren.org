---
export const prerender = false;

import { generateState, generatePkce, buildAuthorizeUrl } from '../../lib/sso';
import { isSecureRequest } from '../../lib/session';

const state = generateState();
const { verifier, challenge } = await generatePkce();

// Secure cookies are silently dropped by browsers over plain HTTP — only
// mark them Secure once actually served over HTTPS (directly, or via the
// reverse proxy in production; see isSecureRequest).
const secure = isSecureRequest(Astro);

// Short-lived, used only to survive the round trip to sso.sovfhub.com and
// back to /portal/callback — not a session cookie.
Astro.cookies.set('sso_state', state, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 300 });
Astro.cookies.set('sso_verifier', verifier, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 300 });

return Astro.redirect(buildAuthorizeUrl(state, challenge));
---
