---
export const prerender = false;

import QRCode from 'qrcode';
import Layout from '../../../layouts/Layout.astro';
import CompanionCard from '../../../components/CompanionCard.astro';
import { fetchUserInfo } from '../../../lib/sso';
import { getSession, clearSession } from '../../../lib/session';
import { getRegisterRecord, type RegisterRecord } from '../../../lib/sovfhub';
import { isAdminCompanion } from '../../../lib/admin';

// Admin-only design prototype of the Certificate of the Identity, populated
// with the signed-in admin's own details. Not an issued credential.
const session = await getSession(Astro);
if (!session) {
  return Astro.redirect('/portal/login');
}

let profile;
try {
  profile = await fetchUserInfo(session.accessToken);
} catch {
  clearSession(Astro);
  return Astro.redirect('/portal/login');
}

if (!isAdminCompanion(profile.companion_number)) {
  return new Response('Not found', { status: 404 });
}

let record: RegisterRecord | null = null;
try {
  record = await getRegisterRecord(profile.companion_number!);
} catch {
  // Register API unreachable — render the card without record fields.
}

const qr = await QRCode.toDataURL(
  new URL(`/register/${profile.companion_number}`, Astro.url.origin).href,
  { width: 300, margin: 1 },
);
---
<Layout title="Certificate of Identity Prototype" noindex>
  <section class="wrap">
    <h1>Certificate of the Identity — design prototype</h1>
    <p class="note">Design mock-up for review. Not an issued credential. Click the card to flip it.</p>
    <CompanionCard
      variant="prototype"
      name={profile.name ?? profile.preferred_username ?? ''}
      companionNumber={profile.companion_number}
      title={record?.credentials}
      sendingState={record?.familyName}
      photoUrl={record?.photoUrl}
      qrCodeDataUrl={qr}
    />
  </section>
</Layout>

<style>
  .wrap { padding: 32px 0; }
  .wrap h1 { font-size: 1.5rem; margin: 0 0 4px; color: var(--sf-text); }
  .note { margin: 0 0 24px; color: var(--sf-text-muted); font-size: 0.9rem; }
</style>
