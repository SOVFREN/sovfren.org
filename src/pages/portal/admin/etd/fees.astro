---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/etd.css';
import { requireAdmin } from '../../../../lib/admin';
import { listInstruments, typeLabel } from '../../../../lib/etd';
import { feeReport } from '../../../../lib/etd-fees';

// Fees bucket: how many instruments have been issued and what fees they earned.
// Figures come from this site's own record of charges; the SovfHub wallet ledger
// (etd_fee_charges) is the record of account.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;

const report = await feeReport();
const instruments = (await listInstruments()).sort((a, b) => b.events[0].at.localeCompare(a.events[0].at));

const withFee = instruments.filter((i) => report.byInstrument.has(i.id));
const free = instruments.length - withFee.length;
const coins = (n: number) => n.toFixed(2);

const months = new Map<string, { issued: number; fees: number; collected: number }>();
for (const i of instruments) {
  const m = i.events[0].at.slice(0, 7);
  const row = months.get(m) ?? { issued: 0, fees: 0, collected: 0 };
  row.issued += 1;
  const fee = report.byInstrument.get(i.id);
  if (fee) {
    row.fees += 1;
    row.collected += Number(fee.amount);
  }
  months.set(m, row);
}
const monthRows = [...months.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const byType = (t: string) => instruments.filter((i) => i.terms.type === t).length;
---
<Layout title="ETD fees" noindex>
  <section class="wrap etd">
    <p class="crumb"><a href="/portal/admin/etd">← Electronic Trade Documents</a></p>
    <h1>Fees</h1>
    <p class="note">Instruments issued and administration fees collected, paid from issuers' SovfHub Treasury Wallets.</p>

    <div class="stats">
      <div class="stat"><span class="n">{instruments.length}</span><span class="l">Instruments issued</span></div>
      <div class="stat"><span class="n">{coins(report.collected)}</span><span class="l">Fees collected (coins)</span></div>
      <div class="stat"><span class="n">{withFee.length}</span><span class="l">Issued with a fee</span></div>
      <div class="stat"><span class="n">{free}</span><span class="l">Issued free</span></div>
      <div class="stat"><span class="n">{report.refunded}</span><span class="l">Fees refunded</span></div>
      <div class={`stat ${report.unsettled ? 'warn' : ''}`}><span class="n">{report.unsettled}</span><span class="l">Awaiting settlement</span></div>
    </div>
    <p class="note">
      {typeLabel('promissory_note')}s: {byType('promissory_note')} · {typeLabel('bill_of_exchange')}s: {byType('bill_of_exchange')}
      {report.unsettled > 0 && <> · <a href="/portal/admin/etd">Settle the unfinished fees</a></>}
    </p>

    <h2>By month</h2>
    {monthRows.length === 0 ? (
      <p class="note">Nothing issued yet.</p>
    ) : (
      <div class="table-card"><table class="stack">
        <thead><tr><th>Month</th><th>Issued</th><th>With fee</th><th>Fees (coins)</th></tr></thead>
        <tbody>
          {monthRows.map(([m, r]) => (
            <tr><td data-label="Month">{m}</td><td data-label="Issued">{r.issued}</td><td data-label="With fee">{r.fees}</td><td data-label="Fees (coins)">{coins(r.collected)}</td></tr>
          ))}
        </tbody>
      </table></div>
    )}

    <h2>Instruments</h2>
    {instruments.length === 0 ? (
      <p class="note">Nothing issued yet.</p>
    ) : (
      <div class="table-card"><table class="stack">
        <thead><tr><th>Serial</th><th>Type</th><th>Issued</th><th>By</th><th>Fee (coins)</th></tr></thead>
        <tbody>
          {instruments.map((i) => {
            const fee = report.byInstrument.get(i.id);
            return (
              <tr>
                <td data-label="Serial"><a href={`/portal/admin/etd/${i.id}`}>{i.terms.serial}</a></td>
                <td data-label="Type">{typeLabel(i.terms.type)}</td>
                <td data-label="Issued">{i.events[0].at.slice(0, 16).replace('T', ' ')}</td>
                <td data-label="By">{i.events[0].by}</td>
                <td data-label="Fee (coins)">{fee ? coins(Number(fee.amount)) : 'free'}</td>
              </tr>
            );
          })}
        </tbody>
      </table></div>
    )}
  </section>
</Layout>
