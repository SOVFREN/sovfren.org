---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import { requireAdmin } from '../../../../lib/admin';
import { listInstruments, typeLabel } from '../../../../lib/etd';
import { feeReport } from '../../../../lib/etd-fees';

// Fees bucket: how many instruments have been issued and what fees they earned.
// Figures come from this site's own record of charges; the SovfHub wallet ledger
// (etd_fee_charges) is the record of account.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;

const report = await feeReport();
const instruments = (await listInstruments()).sort((a, b) => b.events[0].at.localeCompare(a.events[0].at));

const withFee = instruments.filter((i) => report.byInstrument.has(i.id));
const free = instruments.length - withFee.length;
const coins = (n: number) => n.toFixed(2);

const months = new Map<string, { issued: number; fees: number; collected: number }>();
for (const i of instruments) {
  const m = i.events[0].at.slice(0, 7);
  const row = months.get(m) ?? { issued: 0, fees: 0, collected: 0 };
  row.issued += 1;
  const fee = report.byInstrument.get(i.id);
  if (fee) {
    row.fees += 1;
    row.collected += Number(fee.amount);
  }
  months.set(m, row);
}
const monthRows = [...months.entries()].sort((a, b) => b[0].localeCompare(a[0]));
const byType = (t: string) => instruments.filter((i) => i.terms.type === t).length;
---
<Layout title="ETD fees" noindex>
  <section class="wrap">
    <p class="note"><a href="/portal/admin/etd">← Electronic Trade Documents</a></p>
    <h1>Fees</h1>
    <p class="note">Instruments issued and administration fees collected, paid from issuers' SovfHub Treasury Wallets.</p>

    <div class="cards">
      <div class="card"><span class="n">{instruments.length}</span><span class="l">Instruments issued</span></div>
      <div class="card"><span class="n">{coins(report.collected)}</span><span class="l">Fees collected (coins)</span></div>
      <div class="card"><span class="n">{withFee.length}</span><span class="l">Issued with a fee</span></div>
      <div class="card"><span class="n">{free}</span><span class="l">Issued free</span></div>
      <div class="card"><span class="n">{report.refunded}</span><span class="l">Fees refunded</span></div>
      <div class={`card ${report.unsettled ? 'warn' : ''}`}><span class="n">{report.unsettled}</span><span class="l">Awaiting settlement</span></div>
    </div>
    <p class="note">
      {typeLabel('promissory_note')}s: {byType('promissory_note')} · {typeLabel('bill_of_exchange')}s: {byType('bill_of_exchange')}
      {report.unsettled > 0 && <> · <a href="/portal/admin/etd">Settle the unfinished fees</a></>}
    </p>

    <h2>By month</h2>
    {monthRows.length === 0 ? (
      <p class="note">Nothing issued yet.</p>
    ) : (
      <table>
        <thead><tr><th>Month</th><th>Issued</th><th>With fee</th><th>Fees (coins)</th></tr></thead>
        <tbody>
          {monthRows.map(([m, r]) => (
            <tr><td>{m}</td><td>{r.issued}</td><td>{r.fees}</td><td>{coins(r.collected)}</td></tr>
          ))}
        </tbody>
      </table>
    )}

    <h2>Instruments</h2>
    {instruments.length === 0 ? (
      <p class="note">Nothing issued yet.</p>
    ) : (
      <table>
        <thead><tr><th>Serial</th><th>Type</th><th>Issued</th><th>By</th><th>Fee (coins)</th></tr></thead>
        <tbody>
          {instruments.map((i) => {
            const fee = report.byInstrument.get(i.id);
            return (
              <tr>
                <td><a href={`/portal/admin/etd/${i.id}`}>{i.terms.serial}</a></td>
                <td>{typeLabel(i.terms.type)}</td>
                <td>{i.events[0].at.slice(0, 16).replace('T', ' ')}</td>
                <td>{i.events[0].by}</td>
                <td>{fee ? coins(Number(fee.amount)) : 'free'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </section>
</Layout>

<style>
  .wrap { padding: 32px 0; max-width: 820px; }
  .wrap h1 { font-size: 1.5rem; margin: 0 0 4px; color: var(--sf-text); }
  .wrap h2 { font-size: 1.1rem; margin: 32px 0 8px; color: var(--sf-text); }
  .note { margin: 0 0 16px; color: var(--sf-text-muted); font-size: 0.9rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 16px 0; }
  .card { display: flex; flex-direction: column; gap: 4px; padding: 14px; border: 1px solid var(--sf-border); border-radius: var(--sf-radius-md); }
  .card.warn { border-color: #8f1717; }
  .n { font-size: 1.6rem; font-weight: 600; color: var(--sf-text); }
  .l { font-size: 0.8rem; color: var(--sf-text-muted); }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; color: var(--sf-text); display: block; overflow-x: auto; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--sf-border); white-space: nowrap; }
  th { color: var(--sf-text-muted); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
</style>
