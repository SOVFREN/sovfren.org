---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/etd.css';
import { requireAdmin } from '../../../../lib/admin';

// Creates a holder key in the browser. The private key is downloaded as a file
// for the holder to keep; only the public key is shown to paste into the system.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;
---
<Layout title="Holder key" noindex>
  <section class="wrap etd">
    <p class="crumb"><a href="/portal/admin/etd">← Electronic Trade Documents</a></p>
    <h1>Create a holder key</h1>
    <p class="note">
      A holder key lets a person endorse, transfer or acknowledge payment of an instrument. It is created here
      in this browser; the private key is never sent to the server. Whoever holds the key file (and its
      passphrase) controls every instrument held under that key, so keep it safe and back it up. If it is lost,
      the instrument is stuck until an admin performs a witnessed key recovery.
    </p>
    <form id="gen" class="f panel">
      <label>Passphrase (strongly recommended)<input type="password" id="pass" autocomplete="new-password" /></label>
      <label>Repeat passphrase<input type="password" id="pass2" autocomplete="new-password" /></label>
      <button type="submit" class="btn">Generate key</button>
    </form>
    <p id="err" role="alert" class="msg bad" hidden></p>
    <div id="out" class="panel" hidden style="margin-top:16px">
      <p class="msg ok">Key created. Your key file has been downloaded. Store it somewhere safe, away from this computer's only copy.</p>
      <label class="pub">Public key (paste this where a public key is requested)
        <textarea id="pub" rows="2" readonly></textarea>
      </label>
    </div>
  </section>
</Layout>

<script>
  import { generateKeyFile } from '../../../../lib/etd-client';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const err = document.getElementById('err')!;
  document.getElementById('gen')!.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    err.hidden = true;
    try {
      if ($('pass').value !== $('pass2').value) throw new Error('Passphrases do not match.');
      if (!$('pass').value && !confirm('Create the key without a passphrase? Anyone who gets the file can use it.')) return;
      const { publicKey, file } = await generateKeyFile($('pass').value);
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([file], { type: 'application/json' }));
      a.download = `etd-key-${publicKey.slice(0, 8).replace(/[^A-Za-z0-9]/g, '_')}.json`;
      a.click();
      ($('pub') as unknown as HTMLTextAreaElement).value = publicKey;
      document.getElementById('out')!.hidden = false;
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : 'Could not create the key.';
      err.hidden = false;
    }
  });
</script>
