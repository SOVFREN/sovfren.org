---
export const prerender = false;

import QRCode from 'qrcode';
import InstrumentDocument from '../../../../../components/InstrumentDocument.astro';
import { requireAdmin } from '../../../../../lib/admin';
import { getInstrument, verifyInstrument } from '../../../../../lib/etd';

// Printable information copy (use the browser's Print > Save as PDF). It is
// deliberately marked as a copy: the authoritative original is the registry
// record, and only the holder it names can transfer the instrument.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;

const inst = await getInstrument(Astro.params.id ?? '');
if (!inst) return new Response('Not found', { status: 404 });

const v = await verifyInstrument(inst);
const last = inst.events[inst.events.length - 1];
const base = new URL(Astro.site ?? Astro.url.origin).origin;
const qr = await QRCode.toDataURL(`${base}/api/etd/${inst.id}`, { margin: 1, width: 240 });
const printedAt = new Date().toISOString().replace('T', ' ').slice(0, 19) + ' UTC';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{inst.terms.serial}: information copy</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --sf-font-display: 'Cormorant Garamond', 'Times New Roman', serif;
      --sf-font-body: Poppins, Helvetica, Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: #eef2f8; font-family: var(--sf-font-body); color: #1b2433; }
    .sheet { max-width: 820px; margin: 0 auto; padding: 16px 16px 40px; }
    .bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 14px; font-size: 0.85rem; }
    .bar button { font: inherit; font-weight: 600; padding: 10px 20px; border: 0; border-radius: 999px; background: #1662d6; color: #fff; cursor: pointer; }
    .bar button:hover { background: #0f4fb5; }
    .banner { border: 1.5px solid #b3261e; background: #fff; color: #8c1d18; padding: 10px 14px; border-radius: 10px; text-align: center; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.03em; margin-bottom: 14px; }
    .banner.fail { background: #b3261e; color: #fff; }
    .meta { margin-top: 14px; font-size: 0.7rem; line-height: 1.6; color: #5b6676; word-break: break-all; }
    @page { size: A4; margin: 12mm; }
    @media print {
      body { background: #fff; }
      .sheet { max-width: none; padding: 0; }
      .bar { display: none; }
    }
  </style>
</head>
<body>
  <main class="sheet">
    <div class="bar">
      <span>Information copy · printed {printedAt}</span>
      <button onclick="window.print()">Print / Save as PDF</button>
    </div>
    <div class={`banner ${v.ok ? '' : 'fail'}`}>
      {v.ok
        ? 'INFORMATION COPY. NOT NEGOTIABLE. Holding or presenting this page confers no rights. Status can change; always check the registry.'
        : 'FAILED VERIFICATION. DO NOT RELY ON THIS DOCUMENT.'}
    </div>
    <InstrumentDocument inst={inst} state={v.state} verified={v.ok} qr={qr} mode="print" />
    <p class="meta">
      Document ID: {inst.id}<br />
      Chain head at printing (event {last.seq}): {last.hash}<br />
      The QR code links to the live registry record, which requires an API key.
    </p>
  </main>
</body>
</html>
