---
export const prerender = false;

import QRCode from 'qrcode';
import InstrumentDocument from '../../../../../components/InstrumentDocument.astro';
import '../../../../../styles/etd.css';
import { requireAdmin } from '../../../../../lib/admin';
import { getInstrument, replay, verifyInstrument } from '../../../../../lib/etd';
import { getPostJob } from '../../../../../lib/etd-send';

// The pack that is printed and posted by recorded delivery: a cover letter, an information copy of the instrument,
// and a claim slip carrying the one-time code. Only available while the postal offer is open. The code is shown
// here and nowhere else, and is deleted from the registry when the offer ends.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;

const inst = await getInstrument(Astro.params.id ?? '');
if (!inst) return new Response('Not found', { status: 404 });

const v = await verifyInstrument(inst);
const offer = replay(inst).state.offer;
const live = !!offer && offer.channel === 'post' && Date.parse(offer.expiresAt) > Date.now();
const job = live && offer ? await getPostJob(offer.tokenHash) : null;

const base = new URL(Astro.site ?? Astro.url.origin).origin;
const claimUrl = job ? `${base}/claim/${inst.id}?t=${job.token}` : '';
const qr = job ? await QRCode.toDataURL(claimUrl, { margin: 1, width: 240 }) : '';
const siteQr = await QRCode.toDataURL(base, { margin: 1, width: 160 });
const code = job ? (job.token.match(/.{8}/g) ?? []).join(' ') : '';
const longDate = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const holder = replay(inst).state.holder;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{inst.terms.serial}: postal pack</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root { --sf-font-display: 'Cormorant Garamond', 'Times New Roman', serif; --sf-font-body: Poppins, Helvetica, Arial, sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #eef2f8; font-family: var(--sf-font-body); color: #1b2433; }
    .pack { max-width: 820px; margin: 0 auto; padding: 16px 16px 40px; }
    .bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 14px; font-size: 0.85rem; }
    .bar button { font: inherit; font-weight: 600; padding: 10px 20px; border: 0; border-radius: 999px; background: #1662d6; color: #fff; cursor: pointer; }
    .warn { border: 1.5px solid #b3261e; background: #fff; color: #8c1d18; padding: 12px 14px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 14px; }
    .page { background: #fff; padding: 22mm 18mm; margin-bottom: 14px; border-radius: 6px; min-height: 250mm; page-break-after: always; break-after: page; }
    .page:last-child { page-break-after: auto; break-after: auto; }
    .letterhead { display: flex; align-items: center; gap: 10px; font-family: var(--sf-font-display); font-size: 1.15rem; font-weight: 600; border-bottom: 1px solid #c7d0de; padding-bottom: 10px; }
    .letterhead img { width: 38px; height: 38px; }
    .addr { margin: 26mm 0 14mm; font-size: 0.95rem; line-height: 1.5; min-height: 32mm; }
    .addr strong { display: block; }
    .letter p { font-size: 0.9rem; line-height: 1.6; margin: 0 0 10px; }
    .letter ol { font-size: 0.9rem; line-height: 1.6; padding-left: 20px; }
    .slip { border: 2px dashed #1b2433; padding: 10mm; border-radius: 8px; }
    .slip h2 { font-family: var(--sf-font-display); font-size: 1.5rem; margin: 0 0 4px; }
    .slip .row { display: flex; gap: 14mm; align-items: center; margin-top: 8mm; }
    .slip img { width: 48mm; height: 48mm; }
    .slip .code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.95rem; line-height: 1.7; letter-spacing: 0.04em; }
    .slip .url { font-size: 0.7rem; word-break: break-all; color: #5b6676; margin-top: 8px; }
    .banner { border: 1.5px solid #b3261e; color: #8c1d18; padding: 8px 12px; border-radius: 10px; text-align: center; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.03em; margin-bottom: 10px; }
    @page { size: A4; margin: 0; }
    @media print {
      body { background: #fff; }
      .pack { max-width: none; padding: 0; }
      .bar, .warn { display: none; }
      .page { margin: 0; border-radius: 0; padding: 16mm 16mm; min-height: 297mm; }
    }
  </style>
</head>
<body>
  <main class="pack">
    {!job ? (
      <div class="warn">
        <strong>There is no print pack for this instrument.</strong> The postal offer may have ended (accepted, withdrawn or expired), or its details are no longer held.
        If it is still locked, withdraw the offer on the instrument page and send it again. <a href={`/portal/admin/etd/${inst.id}`}>Back to the instrument</a>
      </div>
    ) : (
      <>
        <div class="bar">
          <span>{inst.terms.serial} · 3 pages: letter, copy of the instrument, claim slip</span>
          <button onclick="window.print()">Print / Save as PDF</button>
        </div>
        <div class="warn">
          <strong>Keep this page private.</strong> The claim slip (page 3) carries the code that lets whoever holds it accept the instrument.
          Print it, post it, and close this page. After printing, <a href={`/portal/admin/etd/${inst.id}`}>record the step on the instrument page</a>: printed, then posted with the tracking number.
          {!v.ok && <> <strong>This instrument failed verification. Do not send it.</strong></>}
        </div>

        <section class="page letter">
          <div class="letterhead"><img src="/images/crest.png" alt="" /><span>Sovfren Society · Electronic Trade Register</span></div>
          <div class="addr">
            <strong>{job.addressee}</strong>
            {job.address.line1}<br />
            {job.address.line2 && <>{job.address.line2}<br /></>}
            {job.address.town}{job.address.postcode ? `, ${job.address.postcode}` : ''}<br />
            {job.address.country}
          </div>
          <p>{longDate(new Date().toISOString())}</p>
          <p><strong>Instrument {inst.terms.serial}</strong> · sent by recorded delivery</p>
          <p>Dear {job.addressee},</p>
          <p>
            {holder.name} has sent you an electronic document through the Sovfren Society Electronic Trade Register. A printed copy is enclosed for you to read.
            The document itself is held in the register. You receive it by accepting it online, which takes a few minutes.
          </p>
          <ol>
            <li>Scan the QR code on the enclosed claim slip, or go to <strong>{base.replace(/^https?:\/\//, '')}/claim</strong> and enter the instrument number and the code from the slip.</li>
            <li>Read the instrument. Create your own key, which is made on your device, and accept.</li>
            <li>Keep the key file it gives you safe. It is the only proof that you hold the instrument.</li>
          </ol>
          <p>
            The claim slip works until <strong>{longDate(offer!.expiresAt)}</strong>. Please keep it private: whoever has it can accept the instrument. Once accepted, you are its holder, and you can hold it, trade it on,
            sell it at a discount before it falls due, or present it for payment.
          </p>
          <p>If this was not meant for you, please tell {holder.name}, or contact the Sovfren Society.</p>
          <p>Yours sincerely,<br />Sovfren Society<br />Electronic Trade Register</p>
        </section>

        <section class="page">
          <div class="banner">INFORMATION COPY. NOT NEGOTIABLE. Holding this page confers no rights. You receive the instrument by accepting it online with the claim slip.</div>
          <InstrumentDocument inst={inst} state={v.state} verified={v.ok} qr={siteQr} mode="print" />
        </section>

        <section class="page">
          <div class="slip">
            <h2>Claim slip</h2>
            <p style="margin:0;font-size:0.85rem">Instrument <strong>{inst.terms.serial}</strong> · for <strong>{job.addressee}</strong> · valid until <strong>{longDate(offer!.expiresAt)}</strong></p>
            <div class="row">
              <img src={qr} alt="QR code to accept the instrument" />
              <div>
                <p style="margin:0 0 6px;font-size:0.85rem"><strong>1.</strong> Scan the QR code, or go to <strong>{base.replace(/^https?:\/\//, '')}/claim</strong></p>
                <p style="margin:0 0 6px;font-size:0.85rem"><strong>2.</strong> Enter the instrument number and this code:</p>
                <p class="code">{code}</p>
              </div>
            </div>
            <p class="url">{claimUrl}</p>
            <p style="font-size:0.8rem;margin:10px 0 0"><strong>Keep this slip private.</strong> Whoever has it can accept the instrument. It works once.</p>
          </div>
        </section>
      </>
    )}
  </main>
</body>
</html>
