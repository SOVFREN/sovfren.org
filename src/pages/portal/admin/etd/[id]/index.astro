---
export const prerender = false;

import QRCode from 'qrcode';
import Layout from '../../../../../layouts/Layout.astro';
import InstrumentDocument from '../../../../../components/InstrumentDocument.astro';
import DiscountCalculator from '../../../../../components/DiscountCalculator.astro';
import { splitPayable } from '../../../../../lib/maturity';
import { issuerLabel, issuerParty } from '../../../../../lib/etd-risk';
import '../../../../../styles/etd.css';
import { requireAdmin } from '../../../../../lib/admin';
import { act, exchangeInstrument, getInstrument, linkProblem, typeLabel, verifyInstrument, type Party } from '../../../../../lib/etd';
import { getSession } from '../../../../../lib/session';
import { findCurrency, getCurrencies } from '../../../../../lib/currencies';
import { getFeeQuote, issueWithFee } from '../../../../../lib/etd-fees';

// One instrument: terms, live verification result, current holder, the signed
// event history, and the acts an admin can record (transfer, deliver, accept,
// pay, cancel).
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;
const adminNumber = gate.profile.companion_number!;
const session = await getSession(Astro);
if (!session) return Astro.redirect('/portal/login');
const { list: currencies } = await getCurrencies();

const id = Astro.params.id ?? '';
let inst = await getInstrument(id);
if (!inst) return new Response('Not found', { status: 404 });

let message: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  const f = (k: string) => String(form.get(k) ?? '');
  const expectSeq = Number(f('seq'));
  try {
    const kind = f('act');
    if (!Number.isInteger(expectSeq)) throw new Error('Bad request.');
    if (kind === 'transfer') {
      const to: Party = { name: f('toName'), ...(f('toRef').trim() ? { ref: f('toRef').trim() } : {}), ...(f('toLei').trim() ? { lei: f('toLei') } : {}) };
      inst = await act(id, expectSeq, { type: 'transfer', to, toKey: f('toKey'), holderSig: f('holderSig') }, adminNumber);
      message = 'Transfer recorded, signed by the holder. The new holder has not yet been marked as delivered.';
    } else if (kind === 'deliver') {
      inst = await act(id, expectSeq, { type: 'deliver', method: f('method'), note: f('note') }, adminNumber);
      message = 'Delivery recorded.';
    } else if (kind === 'accept') {
      inst = await act(id, expectSeq, { type: 'accept' }, adminNumber);
      message = 'Acceptance recorded.';
    } else if (kind === 'pay') {
      if (f('confirm') !== 'yes') throw new Error('Tick the confirmation box.');
      inst = await act(id, expectSeq, { type: 'pay', note: f('note'), holderSig: f('holderSig') }, adminNumber);
      message = 'Marked paid. The instrument is discharged.';
    } else if (kind === 'cancel') {
      if (f('confirm') !== 'yes') throw new Error('Tick the confirmation box.');
      inst = await act(id, expectSeq, { type: 'cancel', reason: f('reason') }, adminNumber);
      message = 'Instrument cancelled.';
    } else if (kind === 'rekey') {
      inst = await act(id, expectSeq, { type: 'rekey', newKey: f('newKey'), holderSig: f('holderSig') }, adminNumber);
      message = 'Holder key changed.';
    } else if (kind === 'recover') {
      if (f('confirm') !== 'yes') throw new Error('Tick the confirmation box.');
      inst = await act(id, expectSeq, { type: 'recover', newKey: f('newKey'), reason: f('reason') }, adminNumber);
      message = 'Holder key replaced by witnessed recovery.';
    } else if (kind === 'exchange') {
      // Replace this instrument with one in another currency, at a rate the holder and issuer agreed.
      const quote = await getFeeQuote(session.accessToken);
      if (!quote) throw new Error('Could not reach SovfHub to price this. Nothing was exchanged or charged.');
      if (quote.charging && f('feeOk') !== 'yes') throw new Error('Please confirm the administration fee.');
      const code = (f('newCurrency') === '__other' ? f('newCurrencyOther') : f('newCurrency')).trim().toUpperCase();
      const picked = findCurrency(currencies, code);
      const out: { old?: typeof inst; created?: typeof inst } = {};
      const { warning } = await issueWithFee(session.accessToken, adminNumber, async () => {
        const r = await exchangeInstrument(
          id,
          expectSeq,
          { newCurrency: code, newSymbol: picked?.symbol, newSymbolAfter: picked?.symbolAfter, rate: f('rate'), holderSig: f('holderSig'), debtorAgreed: f('debtorAgreed') === 'yes' },
          adminNumber,
        );
        out.old = r.old;
        out.created = r.created;
        return r.created;
      });
      if (!warning) return Astro.redirect(`/portal/admin/etd/${out.created!.id}`);
      inst = out.old!;
      message = `${warning} The new instrument is ${out.created!.terms.serial}.`;
    } else throw new Error('Unknown action.');
  } catch (e) {
    error = e instanceof Error ? e.message : 'Could not record that.';
    inst = (await getInstrument(id))!;
  }
}

const v = await verifyInstrument(inst);
const t = inst.terms;
const last = inst.events[inst.events.length - 1];
const verifyUrl = new URL(`/portal/admin/etd/${inst.id}`, Astro.site ?? Astro.url.origin).href;
const qr = await QRCode.toDataURL(verifyUrl, { margin: 2, width: 160 });
const active = v.ok && v.state?.status === 'active';
// Discounting only makes sense for an active instrument with a fixed maturity that is still in the future.
const due = splitPayable(t.payableOn);
const todayStr = new Date().toISOString().slice(0, 10);
const canDiscount = active && !due.onDemand && !!due.date && todayStr < due.date;
// Exchanging needs a live instrument that has not yet passed its maturity date.
const canExchange = active && (due.onDemand || (!!due.date && due.date >= todayStr));
const feeQuote = canExchange ? await getFeeQuote(session.accessToken) : null;
const link = await linkProblem(inst);
const exchangeEvent = inst.events.find((e) => e.type === 'exchange')?.data as { newId: string; newSerial: string } | undefined;
const issuer = issuerLabel(issuerParty(t));
const pName = (p?: Party) => (p ? p.name + (p.ref ? ` (${p.ref})` : '') + (p.lei ? ` LEI ${p.lei}` : '') : '—');
---
<Layout title={`${t.serial} — ETD`} noindex>
  <section class="wrap etd">
    <p class="crumb"><a href="/portal/admin/etd">← All instruments</a> · <a href="/portal/admin/etd/help">User guide</a></p>

    {error && <p role="alert" class="msg bad">{error}</p>}
    {message && <p role="status" class="msg ok">{message}</p>}

    {link && <p role="alert" class="msg bad"><strong>Linked instrument problem.</strong> {link}</p>}

    {v.ok
      ? <p class="msg ok"><strong>Verified.</strong> Signatures and event chain are intact. Status: <strong>{v.state?.status}</strong>.</p>
      : <div class="msg bad" role="alert"><strong>Failed verification. Do not rely on this instrument.</strong><ul>{v.errors.map((e) => <li>{e}</li>)}</ul></div>}

    <div class="layout">
      <InstrumentDocument inst={inst} state={v.state} verified={v.ok} qr={qr} />

      <aside class="side">
        <div class="panel">
          <dl class="kv">
            <dt>Current holder</dt><dd><strong>{pName(v.state?.holder)}</strong></dd>
            <dt>Delivery</dt>
            <dd>{v.state?.delivered ? `Delivered to ${pName(v.state.delivered.to)} by ${v.state.delivered.method}, ${v.state.delivered.at.slice(0, 10)}` : 'Not yet delivered to the current holder'}</dd>
            {t.type === 'bill_of_exchange' && <><dt>Acceptance</dt><dd>{v.state?.accepted ? 'Accepted by the drawee' : 'Not yet accepted'}</dd></>}
            {t.replaces && <><dt>Replaces</dt><dd><a href={`/portal/admin/etd/${t.replaces.id}`}>{t.replaces.serial}</a></dd></>}
            {exchangeEvent && <><dt>Exchanged for</dt><dd><a href={`/portal/admin/etd/${exchangeEvent.newId}`}>{exchangeEvent.newSerial}</a></dd></>}
            <dt>Events recorded</dt><dd>{inst.events.length}</dd>
          </dl>
        </div>
        <div class="panel">
          <div class="btn-stack">
            <a class="btn" href={`/portal/admin/etd/${inst.id}/print`} target="_blank">Printable copy</a>
            <a class="btn btn-outline-dark" href={`/portal/admin/etd/${inst.id}/bundle.json`}>Download signed bundle</a>
            <a class="btn btn-outline-dark" href={`/portal/admin/etd/${inst.id}/export.json`}>Standard export (JSON)</a>
          </div>
        </div>
      </aside>
    </div>

    {canDiscount && (
      <DiscountCalculator
        face={t.maturityValue ?? t.amount}
        currency={t.currency}
        issuedAt={t.issuedAt}
        maturityDate={due.date!}
        dayCount={t.dayCount ?? 'ACT/365'}
      />
    )}

    {active && (
      <>
        <h2>Record an act</h2>
        <div class="acts">
          <details class="act">
            <summary><span>Transfer to a new holder <span class="sub">signed by the current holder</span></span></summary>
            <form method="post" class="f signed" data-sign="transfer">
              <input type="hidden" name="act" value="transfer" /><input type="hidden" name="seq" value={last.seq} />
              <div class="row">
                <label>New holder name<input name="toName" required maxlength="120" /></label>
                <label>Companion No. / ref<input name="toRef" maxlength="60" /></label>
                <label>LEI (optional)<input name="toLei" maxlength="20" /></label>
              </div>
              <label>New holder's public key<textarea name="toKey" rows="2" required class="mono"></textarea></label>
              <fieldset><legend>Current holder signs</legend>
                <label>Key file<input type="file" class="keyfile" accept=".json,application/json" required /></label>
                <label>Passphrase<input type="password" class="pass" autocomplete="off" /></label>
              </fieldset>
              <input type="hidden" name="holderSig" />
              <button class="btn" type="submit">Sign and record transfer</button>
            </form>
          </details>

          <details class="act">
            <summary><span>Delivery <span class="sub">to the current holder</span></span></summary>
            <form method="post" class="f">
              <input type="hidden" name="act" value="deliver" /><input type="hidden" name="seq" value={last.seq} />
              <label>Method<input name="method" required maxlength="120" placeholder="Registered Post / hand / secure link" /></label>
              <label>Note (optional)<input name="note" maxlength="500" /></label>
              <button class="btn" type="submit">Record delivery</button>
            </form>
          </details>

          {t.type === 'bill_of_exchange' && !v.state?.accepted && (
            <details class="act">
              <summary><span>Acceptance <span class="sub">the drawee agrees to pay</span></span></summary>
              <form method="post" class="f">
                <input type="hidden" name="act" value="accept" /><input type="hidden" name="seq" value={last.seq} />
                <button class="btn" type="submit">Record acceptance</button>
              </form>
            </details>
          )}

          <details class="act">
            <summary><span>Mark paid <span class="sub">signed by the holder</span></span></summary>
            <form method="post" class="f signed" data-sign="pay">
              <input type="hidden" name="act" value="pay" /><input type="hidden" name="seq" value={last.seq} />
              <label>Note (optional)<input name="note" maxlength="500" /></label>
              <fieldset><legend>Holder acknowledges payment</legend>
                <label>Key file<input type="file" class="keyfile" accept=".json,application/json" required /></label>
                <label>Passphrase<input type="password" class="pass" autocomplete="off" /></label>
              </fieldset>
              <input type="hidden" name="holderSig" />
              <label class="chk"><input type="checkbox" name="confirm" value="yes" required /> Payment received in full. This discharges the instrument permanently.</label>
              <button class="btn" type="submit">Mark paid</button>
            </form>
          </details>

          <details class="act">
            <summary><span>Change holder key <span class="sub">signed with the current key</span></span></summary>
            <form method="post" class="f signed" data-sign="rekey">
              <input type="hidden" name="act" value="rekey" /><input type="hidden" name="seq" value={last.seq} />
              <label>New public key<textarea name="newKey" rows="2" required class="mono"></textarea></label>
              <fieldset><legend>Current key signs</legend>
                <label>Key file<input type="file" class="keyfile" accept=".json,application/json" required /></label>
                <label>Passphrase<input type="password" class="pass" autocomplete="off" /></label>
              </fieldset>
              <input type="hidden" name="holderSig" />
              <button class="btn" type="submit">Sign and change key</button>
            </form>
          </details>

          <details class="act">
            <summary><span>Lost key <span class="sub">witnessed recovery</span></span></summary>
            <form method="post" class="f">
              <input type="hidden" name="act" value="recover" /><input type="hidden" name="seq" value={last.seq} />
              <label>New public key<textarea name="newKey" rows="2" required class="mono"></textarea></label>
              <label>How the holder was verified<input name="reason" required maxlength="500" /></label>
              <label class="chk"><input type="checkbox" name="confirm" value="yes" required /> I have verified the holder in person. This is recorded as registry-witnessed, not holder-signed.</label>
              <button class="btn" type="submit">Replace key</button>
            </form>
          </details>

          {canExchange && (
            <details class="act" id="exchange" data-amount={t.amount} data-rate={t.interestRate ?? ''} data-daycount={t.dayCount ?? 'ACT/365'} data-issued={t.issuedAt} data-currency={t.currency}>
              <summary><span>Exchange into another currency <span class="sub">agreed with the issuer, signed by the holder</span></span></summary>
              <form method="post" class="f signed" data-sign="exchange">
                <input type="hidden" name="act" value="exchange" /><input type="hidden" name="seq" value={last.seq} />
                <p class="note" style="margin:0">
                  The holder and the issuer have agreed to replace this instrument with one in another currency, at a rate they have agreed between themselves.
                  The registry only keeps the record: it does not set the rate or move any money. The new instrument is for the same holder and issuer, and this one is closed.
                </p>
                <div class="row">
                  <label>New currency
                    <select name="newCurrency" required>
                      {currencies.filter((c) => c.code !== t.currency).map((c) => <option value={c.code}>{c.symbol} · {c.code} · {c.name}</option>)}
                      <option value="__other">Other (enter a code)…</option>
                    </select>
                  </label>
                  <label>Agreed rate: 1 {t.currency} =<input name="rate" required inputmode="decimal" placeholder="0.95" /></label>
                </div>
                <label id="ex-other" hidden>Currency code (3 letters)<input name="newCurrencyOther" maxlength="3" placeholder="ZAR" style="text-transform:uppercase" /></label>
                <div class="calc-preview" id="ex-preview" aria-live="polite" hidden></div>
                <fieldset><legend>Current holder signs</legend>
                  <label>Key file<input type="file" class="keyfile" accept=".json,application/json" required /></label>
                  <label>Passphrase<input type="password" class="pass" autocomplete="off" /></label>
                </fieldset>
                <label class="chk"><input type="checkbox" name="debtorAgreed" value="yes" required /> <span>{issuer || 'The issuer'} has agreed to this exchange.</span></label>
                {feeQuote?.charging && (
                  <label class="chk"><input type="checkbox" name="feeOk" value="yes" required /> <span>Charge the administration fee of <strong>{feeQuote.amount} coins</strong> to my Treasury Wallet (balance {feeQuote.balance}). It is returned if this fails.</span></label>
                )}
                <input type="hidden" name="holderSig" />
                <button class="btn" type="submit">Sign and exchange</button>
              </form>
            </details>
          )}

          <details class="act">
            <summary><span>Cancel <span class="sub">permanent</span></span></summary>
            <form method="post" class="f">
              <input type="hidden" name="act" value="cancel" /><input type="hidden" name="seq" value={last.seq} />
              <label>Reason<input name="reason" required maxlength="500" /></label>
              <label class="chk"><input type="checkbox" name="confirm" value="yes" required /> Cancel permanently. This cannot be undone.</label>
              <button class="btn danger" type="submit">Cancel instrument</button>
            </form>
          </details>
        </div>
      </>
    )}

    <h2>History</h2>
    <ol class="timeline">
      {inst.events.map((e) => (
        <li class={['transfer', 'pay', 'rekey'].includes(e.type) ? 'signed' : e.type === 'recover' ? 'witness' : ''}>
          <strong>{e.type.charAt(0).toUpperCase() + e.type.slice(1)}</strong>
          {['transfer', 'pay', 'rekey'].includes(e.type) && <span class="tag">holder-signed</span>}
          {e.type === 'recover' && <span class="tag witness">registry-witnessed</span>}
          <div class="when">{e.at.replace('T', ' ').slice(0, 19)} UTC · recorded by {e.by}</div>
          {e.type === 'transfer' && <div>{pName((e.data as any).from)} → {pName((e.data as any).to)}</div>}
          {e.type === 'deliver' && <div>{(e.data as any).method}</div>}
          {e.type === 'cancel' && <div>{(e.data as any).reason}</div>}
          {e.type === 'recover' && <div>{(e.data as any).reason}</div>}
        </li>
      ))}
    </ol>

    <details class="more">
      <summary>Technical details</summary>
      <div class="tech">
        <p><strong>Document hash (ID)</strong><br /><code>{inst.id}</code></p>
        <p><strong>Head of chain</strong><br /><code>{last.hash}</code></p>
        <p><strong>Signing key</strong><br /><code>{inst.kid}</code></p>
        <p><strong>Holder public key</strong><br /><code>{v.state?.holderKey}</code></p>
      </div>
    </details>
  </section>
</Layout>

<script define:vars={{ docId: inst.id, docPrev: last.hash, docSeq: String(last.seq + 1) }}>
  window.__etd = { docId, docPrev, docSeq };
</script>
<script>
  import { actMessage, signWithKeyFile } from '../../../../../lib/etd-client';
  import { amountInWords } from '../../../../../lib/amount-words';
  import { convertCents, formatCents, formatFxRate, isDayCount, parseCents, parseFxRate, valueToday } from '../../../../../lib/maturity';
  const ctx = (window as any).__etd as { docId: string; docPrev: string; docSeq: string };
  // Exchange: show what the holder is giving up and getting, and prepare exactly what they will sign.
  const exBox = document.getElementById('exchange');
  if (exBox) {
    const form = exBox.querySelector('form') as HTMLFormElement;
    const d = exBox.dataset as { amount: string; rate: string; daycount: string; issued: string; currency: string };
    const preview = document.getElementById('ex-preview')!;
    const pick = form.elements.namedItem('newCurrency') as HTMLSelectElement;
    const other = form.elements.namedItem('newCurrencyOther') as HTMLInputElement;
    const rateInput = form.elements.namedItem('rate') as HTMLInputElement;
    const fmt = (v: string) => {
      const [i, c] = v.split('.');
      return `${i.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}.${c}`;
    };
    const run = () => {
      const isOther = pick.value === '__other';
      document.getElementById('ex-other')!.hidden = !isOther;
      other.required = isOther;
      form.dataset.sigArgs = '';
      preview.replaceChildren();
      const code = (isOther ? other.value : pick.value).trim().toUpperCase();
      const rate = parseFxRate(rateInput.value);
      if (!rateInput.value.trim() || rate === null || !/^[A-Z]{3}$/.test(code)) return void (preview.hidden = true);
      const today = new Date().toISOString().slice(0, 10);
      const dc = isDayCount(d.daycount) ? d.daycount : 'ACT/365';
      const value = valueToday(d.amount, d.rate || undefined, dc, d.issued, today);
      const cents = value ? parseCents(value) : null;
      if (!value || cents === null) return void (preview.hidden = true);
      const out = formatCents(convertCents(cents, rate));
      form.dataset.sigArgs = JSON.stringify([code, formatFxRate(rate), out]);
      preview.hidden = false;
      const line = document.createElement('span');
      line.textContent = `Worth ${d.currency} ${fmt(value)} today. At 1 ${d.currency} = ${formatFxRate(rate)} ${code}, the new instrument is ${code} ${fmt(out)}.`;
      preview.append(line);
      const words = amountInWords(out, code);
      if (words) {
        const em = document.createElement('em');
        em.textContent = words;
        preview.append(em);
      }
    };
    form.addEventListener('input', run);
    run();
  }

  document.querySelectorAll<HTMLFormElement>('form.signed').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      if (form.dataset.done) return;
      ev.preventDefault();
      const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
      const type = form.dataset.sign!;
      const args =
        type === 'transfer'
          ? [val('toName'), val('toRef'), val('toKey')]
          : type === 'rekey'
            ? [val('newKey')]
            : type === 'exchange'
              ? (JSON.parse(form.dataset.sigArgs ?? 'null') as string[] | null) ?? []
              : [];
      if (type === 'exchange' && args.length !== 3) {
        alert('Enter the new currency and a valid agreed rate first.');
        return;
      }
      try {
        const file = form.querySelector<HTMLInputElement>('.keyfile')!.files![0];
        const pass = form.querySelector<HTMLInputElement>('.pass')!.value;
        const { sig } = await signWithKeyFile(await file.text(), pass, actMessage(ctx.docId, ctx.docSeq, ctx.docPrev, type, args));
        (form.elements.namedItem('holderSig') as HTMLInputElement).value = sig;
        form.dataset.done = '1';
        form.submit();
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Could not sign.');
      }
    });
  });
</script>

