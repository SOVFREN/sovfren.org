---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/etd.css';
import { requireAdmin } from '../../../../lib/admin';
import { createApiKey, listApiKeys, revokeApiKey } from '../../../../lib/etd-apikeys';

// Admin management of read-only API keys for counterparties and custodians.
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;
const adminNumber = gate.profile.companion_number!;

let error: string | null = null;
let newKey: string | null = null;

if (Astro.request.method === 'POST') {
  if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  try {
    if (form.get('do') === 'revoke') await revokeApiKey(String(form.get('id') ?? ''));
    else newKey = (await createApiKey(String(form.get('label') ?? ''), adminNumber)).key;
  } catch (e) {
    error = e instanceof Error ? e.message : 'Could not do that.';
  }
}

const keys = (await listApiKeys()).sort((a, b) => b.createdAt.localeCompare(a.createdAt));
const fmt = (iso?: string) => (iso ? iso.replace('T', ' ').slice(0, 16) : '—');
const base = new URL(Astro.site ?? Astro.url.origin).origin;
---
<Layout title="ETD API keys" noindex>
  <section class="wrap etd">
    <p class="crumb"><a href="/portal/admin/etd">← Electronic Trade Documents</a></p>
    <h1>API keys</h1>
    <p class="note">
      Read-only keys let a counterparty, bank or custodian check an instrument's live status and fetch its signed
      bundle. A key can never change anything. Give one key per organisation so each can be revoked on its own.
    </p>

    {error && <p role="alert" class="msg bad">{error}</p>}
    {newKey && (
      <div class="msg ok" role="status">
        <strong>Copy this key now. It will not be shown again.</strong>
        <p class="key">{newKey}</p>
      </div>
    )}

    <form method="post" class="f panel" style="max-width:460px;margin-bottom:24px">
      <label>Label (who is this for?)<input name="label" required maxlength="80" /></label>
      <button class="btn" type="submit">Create key</button>
    </form>

    {keys.length > 0 && (
      <div class="table-card"><table class="stack">
        <thead><tr><th>Label</th><th>Key</th><th>Created</th><th>Last used</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {keys.map((k) => (
            <tr>
              <td data-label="Label">{k.label}</td>
              <td data-label="Key"><code>{k.prefix}…</code></td>
              <td data-label="Created">{fmt(k.createdAt)}</td>
              <td data-label="Last used">{fmt(k.lastUsedAt)}</td>
              <td data-label="Status">{k.revokedAt ? `revoked ${fmt(k.revokedAt)}` : 'active'}</td>
              <td data-label="">
                {!k.revokedAt && (
                  <form method="post"><input type="hidden" name="do" value="revoke" /><input type="hidden" name="id" value={k.id} /><button class="link" type="submit">Revoke</button></form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table></div>
    )}

    <h2>Using a key</h2>
    <pre>curl -H "Authorization: Bearer etdk_..." \
  {base}/api/etd/&lt;instrument id&gt;

# signed, offline-verifiable bundle
curl -H "Authorization: Bearer etdk_..." \
  {base}/api/etd/&lt;instrument id&gt;/bundle</pre>
  </section>
</Layout>
