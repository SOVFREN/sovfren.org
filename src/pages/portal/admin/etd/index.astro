---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import '../../../../styles/etd.css';
import { requireAdmin } from '../../../../lib/admin';
import { issue, listInstruments, replay, typeLabel, type InstrumentType } from '../../../../lib/etd';
import { getSession } from '../../../../lib/session';
import { getFeeQuote, issueWithFee, settleFee, unsettledFees } from '../../../../lib/etd-fees';

// Admin-only register of Electronic Trade Documents: issue Promissory Notes
// and Bills of Exchange, and see every instrument's current status and holder.
// Issuing costs an administration fee, paid from the issuer's SovfHub Treasury
// Wallet (the amount is set on SovfHub; 0 means free).
const gate = await requireAdmin(Astro);
if (gate instanceof Response) return gate;
const { profile } = gate;
const session = await getSession(Astro);
if (!session) return Astro.redirect('/portal/login');

let error: string | null = null;
let message: string | null = null;
const posted: Record<string, string> = {}; // kept so a failed issue doesn't lose what was typed

if (Astro.request.method === 'POST') {
  // Reject cross-site form posts.
  if (Astro.request.headers.get('origin') !== Astro.url.origin) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  form.forEach((v, k) => {
    if (typeof v === 'string') posted[k] = v;
  });
  const f = (k: string) => String(form.get(k) ?? '');
  const party = (p: string) => ({ name: f(`${p}Name`), ref: f(`${p}Ref`), lei: f(`${p}Lei`), bic: f(`${p}Bic`) });
  if (f('do') === 'settle') {
    try {
      const entry = (await unsettledFees()).find((e) => e.reference === f('reference') && e.by === profile.companion_number);
      if (!entry) throw new Error('Only the person who was charged can settle this fee.');
      await settleFee(session.accessToken, entry);
      message = 'Fee settled.';
    } catch (e) {
      error = e instanceof Error ? e.message : 'Could not settle that fee.';
    }
  } else
  try {
    const quote = await getFeeQuote(session.accessToken);
    if (!quote) throw new Error('Could not reach SovfHub to price this. Nothing was issued or charged.');
    if (quote.charging && f('feeOk') !== 'yes') throw new Error('Please confirm the administration fee.');
    const { instrument: created, warning } = await issueWithFee(session.accessToken, profile.companion_number!, () =>
     issue(
      {
        type: f('type') as InstrumentType,
        amount: f('amount'),
        currency: f('currency'),
        issuedAt: f('issuedAt'),
        placeOfIssue: f('placeOfIssue'),
        payableOn: f('payableOn'),
        payee: party('payee'),
        payeeKey: f('payeeKey'),
        maker: party('maker'),
        drawer: party('drawer'),
        drawee: party('drawee'),
        interest: f('interest'),
        governingLaw: f('governingLaw'),
        identifiers: { isin: f('isin'), sedol: f('sedol'), cusip: f('cusip'), cfi: f('cfi') },
        clauses: f('clauses'),
      },
      profile.companion_number!,
     ),
    );
    if (!warning) return Astro.redirect(`/portal/admin/etd/${created.id}`);
    message = `${warning} Instrument: ${created.terms.serial}.`;
  } catch (e) {
    error = e instanceof Error ? e.message : 'Could not issue that.';
  }
}

const all = (await listInstruments()).sort((a, b) => b.terms.serial.localeCompare(a.terms.serial));
const today = new Date().toISOString().slice(0, 10);
const quote = await getFeeQuote(session.accessToken);
const stuck = (await unsettledFees()).filter((e) => e.by === profile.companion_number);
const rows = all.map((i) => ({ i, s: replay(i).state }));
const count = (st: string) => rows.filter((r) => r.s.status === st).length;
const val = (k: string, d = '') => posted[k] ?? d;
const type = val('type', 'promissory_note');
const money = (v: string) => {
  const [int, dec = '00'] = v.split('.');
  return `${int.replace(/\B(?=(\d{3})+(?!\d))/g, ',')}.${dec.padEnd(2, '0')}`;
};
---
<Layout title="Electronic Trade Documents" noindex>
  <section class="wrap etd">
    <header class="page-head">
      <span class="eyebrow">Sovfren Society · Trade Register</span>
      <h1>Electronic Trade Documents</h1>
      <p class="lead">Issue, transfer and settle Promissory Notes and Bills of Exchange, each sealed with a digital signature.</p>
      <nav class="etd-nav" aria-label="Trade documents">
        <a href="/portal/admin/etd" aria-current="page">Instruments</a>
        <a href="#issue">Issue new</a>
        <a href="/portal/admin/etd/keys">Holder key</a>
        <a href="/portal/admin/etd/api-keys">API keys</a>
        <a href="/portal/admin/etd/fees">Fees</a>
        <a href="/portal/admin/etd/help">User guide</a>
        <a href="/portal">Portal</a>
      </nav>
    </header>

    {error && <p role="alert" class="msg bad">{error}</p>}
    {message && <p role="status" class="msg ok">{message}</p>}

    {stuck.length > 0 && (
      <div class="msg warn">
        <strong>Fees to settle</strong>
        {stuck.map((s) => (
          <form method="post" class="settle">
            <input type="hidden" name="do" value="settle" /><input type="hidden" name="reference" value={s.reference} />
            <span>{s.amount} coins · {s.instrument ? 'instrument issued, fee not confirmed' : 'not issued, fee to return'} · {s.at.slice(0, 16).replace('T', ' ')}</span>
            <button class="btn" type="submit">Settle now</button>
          </form>
        ))}
      </div>
    )}

    <div class="stats">
      <div class="stat"><span class="n">{rows.length}</span><span class="l">Instruments</span></div>
      <div class="stat"><span class="n">{count('active')}</span><span class="l">Active</span></div>
      <div class="stat"><span class="n">{count('paid')}</span><span class="l">Paid</span></div>
      <div class="stat"><span class="n">{count('cancelled')}</span><span class="l">Cancelled</span></div>
    </div>

    {rows.length === 0 ? (
      <div class="panel empty">No instruments issued yet. Start with the form below.</div>
    ) : (
      <div class="table-card">
        <table class="stack">
          <thead><tr><th>Serial</th><th>Type</th><th>Amount</th><th>Holder</th><th>Status</th></tr></thead>
          <tbody>
            {rows.map(({ i, s }) => (
              <tr>
                <td data-label="Serial"><a href={`/portal/admin/etd/${i.id}`}>{i.terms.serial}</a></td>
                <td data-label="Type">{typeLabel(i.terms.type)}</td>
                <td data-label="Amount">{i.terms.currency} {money(i.terms.amount)}</td>
                <td data-label="Holder">{s.holder.name}</td>
                <td data-label="Status"><span class={`pill ${s.status}`}>{s.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <h2 id="issue">Issue an instrument</h2>
    <p class="note">Once issued, the terms are sealed with a digital signature and cannot be edited. To change anything, cancel and issue a new one.</p>

    <form method="post" class="f panel" id="issue-form">
      <div class="step">
        <p class="step-title"><span class="num">1</span> Choose a template</p>
        <div class="chips" role="group" aria-label="Quick templates">
          <button type="button" class="chip" data-type="promissory_note" data-days="0">Demand note</button>
          <button type="button" class="chip" data-type="promissory_note" data-days="30">30-day note</button>
          <button type="button" class="chip" data-type="bill_of_exchange" data-days="30">30-day bill</button>
          <button type="button" class="chip" data-type="bill_of_exchange" data-days="90">90-day bill</button>
        </div>
        <div class="type-cards">
          <label class="type-card">
            <input type="radio" name="type" value="promissory_note" checked={type === 'promissory_note'} />
            <span class="body"><strong>Promissory Note</strong><span>A written promise by the maker to pay the holder.</span></span>
          </label>
          <label class="type-card">
            <input type="radio" name="type" value="bill_of_exchange" checked={type === 'bill_of_exchange'} />
            <span class="body"><strong>Bill of Exchange</strong><span>An order from the drawer to the drawee to pay the holder.</span></span>
          </label>
        </div>
      </div>

      <div class="step">
        <p class="step-title"><span class="num">2</span> Amount and dates</p>
        <div class="row">
          <label>Amount<input name="amount" required inputmode="decimal" placeholder="12500.00" value={val('amount')} /></label>
          <label>Currency<input name="currency" required maxlength="3" value={val('currency', 'GBP')} style="text-transform:uppercase" /></label>
        </div>
        <div class="row">
          <label>Issue date<input type="date" name="issuedAt" required value={val('issuedAt', today)} /></label>
          <label>Payable on (date or "on demand")<input name="payableOn" required value={val('payableOn', 'on demand')} /></label>
        </div>
        <label>Place of issue<input name="placeOfIssue" required maxlength="120" value={val('placeOfIssue')} /></label>
      </div>

      <div class="step">
        <p class="step-title"><span class="num">3</span> Parties</p>
        <div class="f">
          <fieldset class="only-note"><legend>Maker (promises to pay)</legend>
            <div class="row"><label>Name<input name="makerName" maxlength="120" value={val('makerName')} /></label><label>Companion No. / ref<input name="makerRef" maxlength="60" value={val('makerRef')} /></label></div>
            <div class="row"><label>LEI (optional)<input name="makerLei" maxlength="20" value={val('makerLei')} /></label><label>BIC (optional)<input name="makerBic" maxlength="11" value={val('makerBic')} /></label></div>
          </fieldset>
          <fieldset class="only-bill"><legend>Drawer (orders payment)</legend>
            <div class="row"><label>Name<input name="drawerName" maxlength="120" value={val('drawerName')} /></label><label>Companion No. / ref<input name="drawerRef" maxlength="60" value={val('drawerRef')} /></label></div>
            <div class="row"><label>LEI (optional)<input name="drawerLei" maxlength="20" value={val('drawerLei')} /></label><label>BIC (optional)<input name="drawerBic" maxlength="11" value={val('drawerBic')} /></label></div>
          </fieldset>
          <fieldset class="only-bill"><legend>Drawee (must pay)</legend>
            <div class="row"><label>Name<input name="draweeName" maxlength="120" value={val('draweeName')} /></label><label>Companion No. / ref<input name="draweeRef" maxlength="60" value={val('draweeRef')} /></label></div>
            <div class="row"><label>LEI (optional)<input name="draweeLei" maxlength="20" value={val('draweeLei')} /></label><label>BIC (optional)<input name="draweeBic" maxlength="11" value={val('draweeBic')} /></label></div>
          </fieldset>
          <fieldset><legend>Payee (pay to the order of)</legend>
            <div class="row"><label>Name<input name="payeeName" required maxlength="120" value={val('payeeName')} /></label><label>Companion No. / ref<input name="payeeRef" maxlength="60" value={val('payeeRef')} /></label></div>
            <div class="row"><label>LEI (optional)<input name="payeeLei" maxlength="20" value={val('payeeLei')} /></label><label>BIC (optional)<input name="payeeBic" maxlength="11" value={val('payeeBic')} /></label></div>
            <label>Payee public key (from their <a href="/portal/admin/etd/keys">holder key</a>)<textarea name="payeeKey" rows="2" required class="mono">{val('payeeKey')}</textarea></label>
          </fieldset>
        </div>
      </div>

      <details class="more" open={!!(posted.interest || posted.governingLaw || posted.clauses || posted.isin || posted.sedol || posted.cusip || posted.cfi)}>
        <summary>Optional details: interest, governing law, identifiers, clauses</summary>
        <div class="f">
          <div class="row">
            <label>Interest<input name="interest" maxlength="120" value={val('interest')} /></label>
            <label>Governing law<input name="governingLaw" maxlength="120" value={val('governingLaw')} /></label>
          </div>
          <fieldset><legend>Market identifiers (assigned by others, validated here)</legend>
            <div class="row">
              <label>ISIN<input name="isin" maxlength="12" value={val('isin')} /></label>
              <label>SEDOL<input name="sedol" maxlength="7" value={val('sedol')} /></label>
              <label>CUSIP<input name="cusip" maxlength="9" value={val('cusip')} /></label>
              <label>CFI<input name="cfi" maxlength="6" value={val('cfi')} /></label>
            </div>
          </fieldset>
          <label>Additional clauses<textarea name="clauses" rows="4" maxlength="4000">{val('clauses')}</textarea></label>
        </div>
      </details>

      <div class="step" style="margin-top:22px;margin-bottom:0">
        {quote?.charging && (
          <label class="chk">
            <input type="checkbox" name="feeOk" value="yes" required />
            <span>Charge the administration fee of <strong>{quote.amount} coins</strong> to my Treasury Wallet (balance {quote.balance}). It is returned if issuing fails.</span>
          </label>
        )}
        {quote && !quote.charging && <p class="note">No administration fee applies at the moment.</p>}
        {!quote && <p class="msg warn">Could not reach SovfHub to check the fee. Issuing is unavailable until it can.</p>}
        <button type="submit" class="btn" disabled={!quote} style="margin-top:14px">Issue and sign</button>
      </div>
    </form>
  </section>
</Layout>

<script>
  const form = document.getElementById('issue-form') as HTMLFormElement;
  const radios = form.querySelectorAll<HTMLInputElement>('input[name="type"]');
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;

  const sync = () => {
    const bill = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value === 'bill_of_exchange';
    form.querySelectorAll<HTMLElement>('.only-bill').forEach((el) => (el.hidden = !bill));
    form.querySelectorAll<HTMLElement>('.only-note').forEach((el) => (el.hidden = bill));
    form.querySelectorAll<HTMLInputElement>('.only-bill input[name$="Name"]').forEach((i) => (i.required = bill));
    form.querySelectorAll<HTMLInputElement>('.only-note input[name$="Name"]').forEach((i) => (i.required = !bill));
  };
  radios.forEach((r) => r.addEventListener('change', sync));

  // Quick templates set the type and the payable-on date relative to the issue date.
  form.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) =>
    chip.addEventListener('click', () => {
      const radio = form.querySelector<HTMLInputElement>(`input[name="type"][value="${chip.dataset.type}"]`)!;
      radio.checked = true;
      const days = Number(chip.dataset.days);
      if (days === 0) {
        field('payableOn').value = 'on demand';
      } else {
        const base = field('issuedAt').value ? new Date(`${field('issuedAt').value}T00:00:00Z`) : new Date();
        base.setUTCDate(base.getUTCDate() + days);
        field('payableOn').value = base.toISOString().slice(0, 10);
      }
      sync();
    }),
  );
  sync();
</script>
