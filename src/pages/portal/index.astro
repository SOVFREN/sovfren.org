---
export const prerender = false;

import QRCode from 'qrcode';
import Layout from '../../layouts/Layout.astro';
import CompanionCard from '../../components/CompanionCard.astro';
import { fetchUserInfo } from '../../lib/sso';
import { getSession, clearSession } from '../../lib/session';
import { getRegisterRecord, uploadRegisterPhoto, type RegisterRecord } from '../../lib/sovfhub';

const session = await getSession(Astro);
if (!session) {
  return Astro.redirect('/portal/login');
}

let profile;
try {
  profile = await fetchUserInfo(session.accessToken);
} catch {
  clearSession(Astro);
  return Astro.redirect('/portal/login');
}

let photoError: string | null = null;

if (Astro.request.method === 'POST' && profile.companion_number) {
  const form = await Astro.request.formData();
  const file = form.get('photo');
  if (file instanceof File && file.size > 0) {
    try {
      await uploadRegisterPhoto(session.accessToken, file);
    } catch {
      photoError = 'Could not upload that photo. Please try a JPG, PNG or WEBP under 8MB.';
    }
  }
}

let registerRecord: RegisterRecord | null = null;
if (profile.companion_number) {
  try {
    registerRecord = await getRegisterRecord(profile.companion_number);
  } catch {
    // Register API unreachable — the portal still works, just without the ID photo.
  }
}

const registerUrl = profile.companion_number
  ? new URL(`/register/${profile.companion_number}`, Astro.url.origin).href
  : null;
const qrCodeDataUrl = registerUrl
  ? await QRCode.toDataURL(registerUrl, { width: 200, margin: 1 })
  : null;
---
<Layout title="Companion Portal" noindex>
  <section class="wrap">
    <h1>Welcome, {profile.name ?? profile.preferred_username}</h1>

    <CompanionCard
      name={profile.name ?? profile.preferred_username}
      companionNumber={profile.companion_number}
      status={registerRecord?.status}
      expiryDate={registerRecord?.expiryDate}
      title={registerRecord?.credentials}
      photoUrl={registerRecord?.photoUrl}
      qrCodeDataUrl={qrCodeDataUrl}
    />

    {profile.companion_number && (
      <div class="photo-upload">
        <h2>{registerRecord?.photoUrl ? 'Change my ID Photo' : 'Add my ID Photo'}</h2>
        <p>Used on your Register/Proof of Life record and this Companion ID. JPG, PNG or WEBP, up to 8MB.</p>
        {photoError && <p role="alert">{photoError}</p>}
        <form method="post" enctype="multipart/form-data" class="photo-upload-form">
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required />
          <button type="submit" class="btn">Upload Photo</button>
        </form>
      </div>
    )}

    <div class="actions">
      {profile.companion_number && (
        <a class="btn" href={`/register/${profile.companion_number}`}>View my Register record</a>
      )}
      <a class="btn btn-outline-dark" href="/portal/notices">My Public Notices</a>

      <form method="post" action="/portal/logout" class="logout-form">
        <button type="submit" class="link-btn">Sign out</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .wrap {
    padding: 32px 0;
  }

  .wrap h1 {
    font-size: 1.5rem;
    color: var(--sf-text);
    margin: 0 0 24px;
  }

  .photo-upload {
    max-width: 480px;
    margin-top: 24px;
    padding: 20px;
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-lg);
  }

  .photo-upload h2 {
    margin: 0 0 4px;
    font-size: 1rem;
    color: var(--sf-text);
  }

  .photo-upload p {
    margin: 0 0 16px;
    font-size: 0.85rem;
    color: var(--sf-text-muted);
  }

  .photo-upload-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .photo-upload-form input[type='file'] {
    flex: 1 1 200px;
    font-size: 0.85rem;
  }

  .actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .logout-form {
    margin-left: auto;
  }

  .link-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--sf-text-muted);
    text-decoration: underline;
    cursor: pointer;
  }
</style>
