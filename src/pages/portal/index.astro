---
export const prerender = false;

import QRCode from 'qrcode';
import Layout from '../../layouts/Layout.astro';
import CompanionCard from '../../components/CompanionCard.astro';
import { isAdminCompanion } from '../../lib/admin';
import {
  hasIdMarksPermission,
  hasMark,
  saveMark,
  saveSignatureDataUrl,
  deleteMark,
} from '../../lib/idmarks';
import { fetchUserInfo } from '../../lib/sso';
import { getSession, clearSession } from '../../lib/session';
import { getRegisterRecord, uploadRegisterPhoto, type RegisterRecord } from '../../lib/sovfhub';

const session = await getSession(Astro);
if (!session) {
  return Astro.redirect('/portal/login');
}

let profile;
try {
  profile = await fetchUserInfo(session.accessToken);
} catch {
  clearSession(Astro);
  return Astro.redirect('/portal/login');
}

let photoError: string | null = null;
let marksError: string | null = null;
let marksSaved: string | null = null;
const canAddMarks = hasIdMarksPermission(profile.companion_number);

class MarksInputError extends Error {}

if (Astro.request.method === 'POST' && profile.companion_number) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'photo');
  const companionNumber = profile.companion_number;

  if (action === 'photo') {
    const file = form.get('photo');
    if (file instanceof File && file.size > 0) {
      try {
        await uploadRegisterPhoto(session.accessToken, file);
      } catch {
        photoError = 'Could not upload that photo. Please try a JPG, PNG or WEBP under 8MB.';
      }
    }
  } else if (canAddMarks) {
    try {
      if (action === 'signature' || action === 'thumbprint') {
        if (form.get('consent') !== 'yes') {
          throw new MarksInputError('Please confirm your consent first.');
        }
        if (action === 'signature') {
          await saveSignatureDataUrl(companionNumber, String(form.get('signatureData') ?? ''));
          marksSaved = 'Autograph saved.';
        } else {
          const file = form.get('thumbprint');
          if (!(file instanceof File) || file.size === 0) {
            throw new MarksInputError('Choose an image of your thumbprint.');
          }
          await saveMark(companionNumber, 'thumbprint', new Uint8Array(await file.arrayBuffer()));
          marksSaved = 'Thumbprint saved.';
        }
      } else if (action === 'remove-signature') {
        await deleteMark(companionNumber, 'signature');
        marksSaved = 'Autograph removed.';
      } else if (action === 'remove-thumbprint') {
        await deleteMark(companionNumber, 'thumbprint');
        marksSaved = 'Thumbprint removed.';
      }
    } catch (e) {
      marksError =
        e instanceof MarksInputError
          ? e.message
          : 'Could not save that. Please use a PNG, JPG or WEBP image under 4MB.';
    }
  }
}

const hasThumbprint =
  profile.companion_number && canAddMarks ? await hasMark(profile.companion_number, 'thumbprint') : false;
const hasSignature =
  profile.companion_number && canAddMarks ? await hasMark(profile.companion_number, 'signature') : false;

let registerRecord: RegisterRecord | null = null;
if (profile.companion_number) {
  try {
    registerRecord = await getRegisterRecord(profile.companion_number);
  } catch {
    // Register API unreachable — the portal still works, just without the ID photo.
  }
}

const registerUrl = profile.companion_number
  ? new URL(`/register/${profile.companion_number}`, Astro.url.origin).href
  : null;
const qrCodeDataUrl = registerUrl
  ? await QRCode.toDataURL(registerUrl, { width: 200, margin: 1 })
  : null;
---
<Layout title="Companion Portal" noindex>
  <section class="wrap">
    <h1>Welcome, {profile.name ?? profile.preferred_username}</h1>

    <CompanionCard
      variant={isAdminCompanion(profile.companion_number) ? 'prototype' : 'standard'}
      sendingState={registerRecord?.familyName}
      thumbprintUrl={hasThumbprint ? '/portal/id-marks/thumbprint' : null}
      signatureUrl={hasSignature ? '/portal/id-marks/signature' : null}
      name={profile.name ?? profile.preferred_username}
      companionNumber={profile.companion_number}
      status={registerRecord?.status}
      expiryDate={registerRecord?.expiryDate}
      title={registerRecord?.credentials}
      photoUrl={registerRecord?.photoUrl}
      qrCodeDataUrl={qrCodeDataUrl}
    />

    {profile.companion_number && (
      <div class="photo-upload">
        <h2>{registerRecord?.photoUrl ? 'Change my ID Photo' : 'Add my ID Photo'}</h2>
        <p>Used on your Register/Proof of Life record and this Companion ID. JPG, PNG or WEBP, up to 8MB.</p>
        {photoError && <p role="alert">{photoError}</p>}
        <form method="post" enctype="multipart/form-data" class="photo-upload-form">
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required />
          <button type="submit" class="btn">Upload Photo</button>
        </form>
      </div>
    )}

    {canAddMarks && (
      <div class="photo-upload marks">
        <h2>Thumbprint &amp; Autograph</h2>
        <p>
          Available to Companions granted this permission. Your thumbprint image and autograph are
          stored privately on the Society's server and appear only in their positions on your
          Certificate of the Identity.
        </p>
        {marksError && <p role="alert">{marksError}</p>}
        {marksSaved && <p role="status">{marksSaved}</p>}

        <h3>Autograph</h3>
        <form method="post" class="marks-form" data-signature-form>
          <input type="hidden" name="action" value="signature" />
          <input type="hidden" name="signatureData" />
          <canvas class="sig-pad" width="800" height="240" aria-label="Draw your autograph"></canvas>
          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required />
            I consent to the Society storing my autograph and showing it on my card.
          </label>
          <div class="marks-actions">
            <button type="submit" class="btn">{hasSignature ? 'Replace autograph' : 'Save autograph'}</button>
            <button type="button" class="link-btn" data-sig-clear>Clear</button>
          </div>
        </form>
        {hasSignature && (
          <form method="post">
            <input type="hidden" name="action" value="remove-signature" />
            <button type="submit" class="link-btn">Remove autograph</button>
          </form>
        )}

        <h3>Thumbprint</h3>
        <form method="post" enctype="multipart/form-data" class="marks-form">
          <input type="hidden" name="action" value="thumbprint" />
          <input type="file" name="thumbprint" accept="image/png,image/jpeg,image/webp" required />
          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required />
            I consent to the Society storing my thumbprint image and showing it on my card.
          </label>
          <div class="marks-actions">
            <button type="submit" class="btn">{hasThumbprint ? 'Replace thumbprint' : 'Upload thumbprint'}</button>
          </div>
        </form>
        {hasThumbprint && (
          <form method="post">
            <input type="hidden" name="action" value="remove-thumbprint" />
            <button type="submit" class="link-btn">Remove thumbprint</button>
          </form>
        )}
      </div>
    )}

    <div class="actions">
      {profile.companion_number && (
        <a class="btn" href={`/register/${profile.companion_number}`}>View my Register record</a>
      )}
      <a class="btn btn-outline-dark" href="/portal/notices">My Public Notices</a>

      <form method="post" action="/portal/logout" class="logout-form">
        <button type="submit" class="link-btn">Sign out</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-signature-form]');
  const canvas = form?.querySelector<HTMLCanvasElement>('.sig-pad');
  const ctx = canvas?.getContext('2d');
  if (form && canvas && ctx) {
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#1d3fa0';
    let drawing = false;
    let inked = false;
    const pos = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return [((e.clientX - r.left) * canvas.width) / r.width, ((e.clientY - r.top) * canvas.height) / r.height];
    };
    canvas.addEventListener('pointerdown', (e) => {
      drawing = true;
      canvas.setPointerCapture(e.pointerId);
      const [x, y] = pos(e);
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x + 0.01, y);
      ctx.stroke();
      inked = true;
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!drawing) return;
      const [x, y] = pos(e);
      ctx.lineTo(x, y);
      ctx.stroke();
    });
    const stop = () => {
      drawing = false;
    };
    canvas.addEventListener('pointerup', stop);
    canvas.addEventListener('pointercancel', stop);
    form.querySelector('[data-sig-clear]')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      inked = false;
    });
    form.addEventListener('submit', (e) => {
      if (!inked) {
        e.preventDefault();
        alert('Please draw your autograph first.');
        return;
      }
      (form.elements.namedItem('signatureData') as HTMLInputElement).value = canvas.toDataURL('image/png');
    });
  }
</script>

<style>
  .wrap {
    padding: 32px 0;
  }

  .wrap h1 {
    font-size: 1.5rem;
    color: var(--sf-text);
    margin: 0 0 24px;
  }

  .photo-upload {
    max-width: 480px;
    margin-top: 24px;
    padding: 20px;
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-lg);
  }

  .photo-upload h2 {
    margin: 0 0 4px;
    font-size: 1rem;
    color: var(--sf-text);
  }

  .photo-upload p {
    margin: 0 0 16px;
    font-size: 0.85rem;
    color: var(--sf-text-muted);
  }

  .photo-upload-form {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .photo-upload-form input[type='file'] {
    flex: 1 1 200px;
    font-size: 0.85rem;
  }

  .marks h3 {
    margin: 20px 0 8px;
    font-size: 0.9rem;
    color: var(--sf-text);
  }

  .marks-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 8px;
  }

  .sig-pad {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 10 / 3;
    background: #fff;
    border: 1px dashed var(--sf-border-strong);
    border-radius: var(--sf-radius-md);
    touch-action: none;
    cursor: crosshair;
  }

  .consent {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.8rem;
    color: var(--sf-text-muted);
  }

  .marks-actions {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .logout-form {
    margin-left: auto;
  }

  .link-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--sf-text-muted);
    text-decoration: underline;
    cursor: pointer;
  }
</style>
