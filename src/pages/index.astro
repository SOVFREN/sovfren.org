---
import Layout from '../layouts/Layout.astro';

const pillars = [
  ['Peace', 'Seeking peaceful relations and the peaceful resolution of differences.'],
  ['Love', 'Showing compassion, kindness, fellowship and care towards others.'],
  ['Honour', 'Acting truthfully, faithfully and with integrity.'],
  ['Good Conscience', 'Endeavouring to do what is fair, responsible and morally right.'],
];
---
<Layout
  title="Sovfren Society — Peace is Power"
  description="The Sovfren Society is a voluntary Society founded on Peace, Love, Honour and Good Conscience — a vessel for Men & Women who seek knowledge, peace and prosperity."
>
  <section class="hero hero-worldbg">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-kicker">The Sovfren Society</p>
      <h1>Peace is Power</h1>
      <p class="hero-sub">
        A voluntary Society for Men &amp; Women who seek knowledge, peace and
        prosperity&mdash;united in fellowship, Stewardship and the responsible advancement
        of humanity.
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href="https://sovfhub.com">Become a Companion</a>
        <a class="btn btn-outline" href="/founding-charter">Read the Charter</a>
      </div>
    </div>
  </section>

  <section class="card crest-card">
    <img src="/images/crest.png" alt="Sovfren Society crest" class="crest" />
    <p class="tagline">The Sovfren Society is the vessel for Men &amp; Women who seek knowledge, peace, and prosperity.</p>
  </section>

  <section class="stack-section">
    <div class="section-heading">
      <p class="kicker">Founding Principles</p>
      <h2>What We Stand For</h2>
    </div>
    <div class="info-grid" style="--info-grid-cols: 4;">
      {pillars.map(([term, text]) => (
        <div class="info-card">
          <h3>{term}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="stack-section">
    <div class="section-heading">
      <p class="kicker">The Society &amp; Sovfhub</p>
      <h2>The Society is Who We Are. Sovfhub is How We Build.</h2>
    </div>
    <div class="duo">
      <div class="info-card">
        <h3>The Sovfren Society</h3>
        <p>A voluntary fellowship of Men &amp; Women founded on Peace, Love, Honour and Good Conscience. It holds the Charter, the values, the Register of Companions and Society Notices.</p>
        <a class="info-card-cta" href="/founding-charter">Read the Charter →</a>
      </div>
      <span class="duo-arrow" aria-hidden="true">→</span>
      <div class="info-card duo-featured">
        <h3>Sovfhub</h3>
        <p>The platform Companions use to take part: communicate, learn, found their own Self-Governing Societies and build together, with more apps once signed up.</p>
        <a class="btn btn-small" href="/sovfhub">Discover Sovfhub →</a>
      </div>
    </div>
  </section>

  <section id="discover" class="card discover-card">
    <div class="discover-text">
      <h2>Discover</h2>
      <p class="discover-sub">Fulfilment &amp; Abundance</p>
      <p>Let's grow together and create a world for everyone.</p>
      <a class="btn" href="/vision">Learn More →</a>
    </div>
    <div class="discover-image">
      <img src="/images/meditate.webp" alt="" />
    </div>
  </section>

  <section class="cta-band">
    <h2>Join the Fellowship</h2>
    <p>Take your place among Companions building peace, prosperity and a stronger inheritance for generations to come.</p>
    <div class="cta-actions">
      <a class="btn btn-light" href="https://sovfhub.com">Become a Companion</a>
      <a class="btn btn-outline" href="/vision">Our Vision →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-worldbg {
    background: url('/images/hero-world.webp') center/cover no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(192deg, rgba(6, 61, 130, 0.6) 0%, rgba(9, 22, 58, 0.82) 100%);
  }

  .crest-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 44px;
    text-align: left;
    flex-wrap: wrap;
  }

  .crest {
    width: 148px;
    height: 148px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 10px 18px rgba(11, 29, 58, 0.14));
  }

  .tagline {
    max-width: 480px;
    font-family: var(--sf-font-display);
    font-style: italic;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--sf-ink);
    margin: 0;
  }

  .stack-section {
    margin: 64px 0;
  }

  .duo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 20px;
  }

  .duo .info-card {
    display: flex;
    flex-direction: column;
    padding: 34px 30px;
  }

  .duo .info-card h3 {
    font-family: var(--sf-font-display);
    font-size: 1.6rem;
  }

  .duo .info-card p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .duo .info-card .btn,
  .duo .info-card .info-card-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .duo-featured {
    border-color: rgba(22, 98, 214, 0.35);
    background: linear-gradient(160deg, var(--sf-primary-soft) 0%, var(--sf-surface) 70%);
  }

  .duo-arrow {
    align-self: center;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--sf-primary);
  }

  @media (max-width: 760px) {
    .duo {
      grid-template-columns: 1fr;
    }

    .duo-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  .discover-card {
    display: flex;
    align-items: center;
    gap: 52px;
    flex-wrap: wrap;
  }

  .discover-text {
    flex: 1 1 320px;
  }

  .discover-text h2 {
    margin: 0 0 4px !important;
  }

  .discover-sub {
    margin: 0 0 16px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--sf-primary-strong);
  }

  .discover-text > p:not(.discover-sub) {
    color: var(--sf-text);
    margin: 0 0 26px;
  }

  .discover-image {
    flex: 1 1 280px;
    display: flex;
    justify-content: center;
  }

  .discover-image img {
    width: 230px;
    height: 230px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--sf-shadow-lift);
    border: 6px solid var(--sf-surface);
    outline: 1px solid var(--sf-border);
  }

  @media (max-width: 640px) {
    .crest-card {
      text-align: center;
      justify-content: center;
    }
  }
</style>
