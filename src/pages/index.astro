---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <section class="hero">
    <div class="hero-overlay"></div>
    <h1>Peace is Power</h1>
  </section>

  <section class="card crest-card">
    <img src="/images/crest.png" alt="Sovfren Society crest" class="crest" />
    <p class="tagline">The Sovfren Society is the vessel for Men &amp; Women who seek knowledge, peace, and prosperity</p>
  </section>

  <section id="discover" class="card discover-card">
    <div class="discover-text">
      <h2>Discover</h2>
      <p class="discover-sub">Fulfilment &amp; Abundance</p>
      <p>Let's grow together and create a world for everyone.</p>
      <a class="btn" href="/vision">Learn More →</a>
    </div>
    <div class="discover-image">
      <img src="/images/meditate.webp" alt="" />
    </div>
  </section>
</Layout>

<style>
  .card {
    background: var(--sf-surface);
    border: 1px solid var(--sf-border);
    border-radius: var(--sf-radius-xl);
    box-shadow: var(--sf-shadow-soft);
    padding: 48px 40px;
    margin: 32px 0;
  }

  .hero {
    position: relative;
    margin: 32px 0;
    border-radius: var(--sf-radius-xl);
    overflow: hidden;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: url('/images/hero-world.webp') center/cover no-repeat;
    box-shadow: var(--sf-shadow);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(192deg, rgba(6, 147, 227, 0.55) 0%, rgba(20, 39, 109, 0.75) 100%);
  }

  .hero h1 {
    position: relative;
    color: #ffffff;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin: 0;
    padding: 0 20px;
  }

  .crest-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    text-align: left;
    flex-wrap: wrap;
  }

  .crest {
    width: 140px;
    height: 140px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .tagline {
    max-width: 480px;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--sf-text);
    margin: 0;
  }

  .discover-card {
    display: flex;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  .discover-text {
    flex: 1 1 320px;
  }

  .discover-text h2 {
    margin: 0 0 4px;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--sf-primary);
  }

  .discover-sub {
    margin: 0 0 16px;
    font-weight: 600;
    color: var(--sf-text-muted);
  }

  .discover-text > p:not(.discover-sub) {
    color: var(--sf-text);
    margin: 0 0 24px;
  }

  .discover-image {
    flex: 1 1 280px;
    display: flex;
    justify-content: center;
  }

  .discover-image img {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--sf-shadow);
  }

  .btn {
    display: inline-block;
    background: var(--sf-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 12px 24px;
    border-radius: var(--sf-radius-full);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn:hover {
    background: var(--sf-primary-strong);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .card {
      padding: 32px 24px;
    }
    .crest-card {
      text-align: center;
      justify-content: center;
    }
  }
</style>
